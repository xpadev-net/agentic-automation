{
  "$schema": "https://biomejs.dev/schemas/biome.schema.json",
  "extends": [],
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.js",
      "src/**/*.jsx",
      "**/*.md",
      "!!**/node_modules",
      "!!**/dist"
    ]
  }
}
