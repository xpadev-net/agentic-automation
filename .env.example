# Database Configuration
# MySQL connection string in format: mysql://user:password@tcp(host:port)/database?charset=utf8mb4&parseTime=True&loc=Local
# Note: Quotes around the value are optional - the Makefile handles both quoted and unquoted values
DATABASE_URL="mysql://agent_user:secure_password@tcp(localhost:3306)/github_agent_automation?charset=utf8mb4&parseTime=True&loc=Local"

# GitHub App Credentials
# GitHub App ID from https://github.com/settings/apps
GITHUB_APP_ID=123456

# GitHub App Private Key (single-line format)
# Download from GitHub App settings and convert to single line
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIEpAIBAAKCAQEA...
...
-----END RSA PRIVATE KEY-----"

# GitHub Webhook Secret
# Random string used to verify webhook payloads from GitHub
GITHUB_WEBHOOK_SECRET=your_webhook_secret_from_github_app

# External Services

# Codex Bot Username
# GitHub username of the Codex bot for comment detection (e.g., "codex-bot")
CODEX_BOT_USERNAME=codex-bot

# Kubernetes Secret names for agent API keys (optional, defaults shown)
# ANTHROPIC_API_KEY_SECRET=anthropic-api-key
# CURSOR_API_KEY_SECRET=cursor-api-key
# CODEX_API_KEY_SECRET=codex-api-key

# Discord Webhook URL
# Discord webhook URL for failure notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456/your_webhook_token

# Agent Runner (Kubernetes Pod)

# Operator Service Configuration
# These values are used by agent-runner to construct the Operator API URL automatically
# The URL is built as: http://{OPERATOR_SERVICE_NAME}.{namespace}.svc.cluster.local:{OPERATOR_SERVICE_PORT}
# namespace is auto-injected via Kubernetes Downward API

# Operator service name (Kubernetes Service name)
OPERATOR_SERVICE_NAME=agent-operator

# Operator service port
OPERATOR_SERVICE_PORT=3000

# Operator API Bearer Token
# Secret token for agent-runner to authenticate with Operator API
OPERATOR_API_TOKEN=your-secret-api-token

# Agent Runner Docker Image
# Container image for the agent-runner Pod
AGENT_RUNNER_IMAGE=ghcr.io/your-org/agent-runner:latest

# Agent Execution Configuration
# Maximum execution time for a Pod in minutes
AI_AGENT_TIMEOUT_MINUTES=30

# Maximum number of concurrent Pod executions
AI_AGENT_MAX_CONCURRENT_PODS=10

# Default AI agent type: claude-code | cursor-agent | codex
AI_AGENT_DEFAULT_TYPE=claude-code

# Codex (OpenAI Codex CLI) Configuration
# API key is injected into agent Pods from a Kubernetes Secret (default name: codex-api-key, key: api-key)
# CODEX_API_KEY_SECRET=codex-api-key
# Optional model override for codex exec -m (empty = Codex CLI default)
# CODEX_MODEL=

# Kubernetes Configuration
# Path to Kubernetes config file (optional, defaults to in-cluster config when running in K8s)
# Only needed for local development
KUBE_CONFIG_PATH=/path/to/.kube/config

# Server Configuration

# Server port (default: 3000)
PORT=3000

# Environment: development | production
ENV=development

# Log level: debug | info | warn | error
LOG_LEVEL=info

# MinIO/S3 Session Storage (for AI Agent session persistence)

# S3 API endpoint
# MinIO: http://minio:9000 or http://localhost:9000
# AWS S3: https://s3.amazonaws.com
S3_ENDPOINT=http://minio:9000

# S3 region
S3_REGION=us-east-1

# S3 bucket name for session storage
S3_BUCKET=agent-sessions

# S3 access credentials
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Use path-style URLs (required for MinIO, optional for AWS S3)
# true: http://endpoint/bucket/key (MinIO)
# false: http://bucket.endpoint/key (AWS S3)
S3_USE_PATH_STYLE=true

# S3 retry configuration
# Maximum number of retry attempts on S3 operation failure
S3_MAX_RETRIES=5

# Initial backoff interval for exponential retry (e.g., 1s, 2s, 500ms)
S3_RETRY_INITIAL_INTERVAL=1s
