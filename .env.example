# Database Configuration
# MySQL connection string in format: mysql://user:password@tcp(host:port)/database?charset=utf8mb4&parseTime=True&loc=Local
# Note: Quotes around the value are optional - the Makefile handles both quoted and unquoted values
DATABASE_URL="mysql://agent_user:secure_password@tcp(localhost:3306)/github_agent_automation?charset=utf8mb4&parseTime=True&loc=Local"

# GitHub App Credentials
# GitHub App ID from https://github.com/settings/apps
GITHUB_APP_ID=123456

# GitHub App Private Key (single-line format)
# Download from GitHub App settings and convert to single line
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIEpAIBAAKCAQEA...
...
-----END RSA PRIVATE KEY-----"

# GitHub Webhook Secret
# Random string used to verify webhook payloads from GitHub
GITHUB_WEBHOOK_SECRET=your_webhook_secret_from_github_app

# External Services

# Codex Bot Username
# GitHub username of the Codex bot for comment detection (e.g., "codex-bot")
CODEX_BOT_USERNAME=codex-bot

# Discord Webhook URL
# Discord webhook URL for failure notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456/your_webhook_token

# Agent Runner (Kubernetes Pod)

# Operator REST API URL
# URL where the Operator API is accessible from Pods
# Format: http://service-name.namespace.svc.cluster.local:port
OPERATOR_API_URL=http://agent-operator.default.svc.cluster.local:3000

# Operator API Bearer Token
# Secret token for agent-runner to authenticate with Operator API
OPERATOR_API_TOKEN=your-secret-api-token

# Agent Runner Docker Image
# Container image for the agent-runner Pod
AGENT_RUNNER_IMAGE=ghcr.io/your-org/agent-runner:latest

# Agent Execution Configuration
# Maximum execution time for a Pod in minutes
AI_AGENT_TIMEOUT_MINUTES=30

# Maximum number of concurrent Pod executions
AI_AGENT_MAX_CONCURRENT_PODS=10

# Default AI agent type: claude-code | cursor-agents
AI_AGENT_DEFAULT_TYPE=claude-code

# Kubernetes Configuration
# Path to Kubernetes config file (optional, defaults to in-cluster config when running in K8s)
# Only needed for local development
KUBE_CONFIG_PATH=/path/to/.kube/config

# Server Configuration

# Server port (default: 3000)
PORT=3000

# Environment: development | production
ENV=development

# Log level: debug | info | warn | error
LOG_LEVEL=info
