review) > 100 {\n\t\tpreview = preview[:100]\n\t}\n\n\ts.logger.Info(\"Codex approval detection result\",\n\t\tzap.Bool(\"approval_detected\", detected),\n\t\tzap.String(\"reviewer_username\", reviewerUsername),\n\t\tzap.String(\"review_body_preview\", preview),\n\t\tzap.String(\"service\", \"codex_approval\"),\n\t)\n\n\t// 5. Return detection result\n\treturn detected\n}","signatures":{"ranges":[]},"detailedLines":[{"text":"// for security purposes.","lineNumber":47,"isSignature":false},{"text":"func (s *CodexApprovalDetector) DetectApproval(reviewBody string, reviewerUsername string) bool {","lineNumber":48,"isSignature":false},{"text":"\t// 1. Validate reviewer username (case-insensitive)","lineNumber":49,"isSignature":false},{"text":"\tif !strings.EqualFold(reviewerUsername, s.codexBotUsername) {","lineNumber":50,"isSignature":false},{"text":"\t\treturn false","lineNumber":51,"isSignature":false},{"text":"\t}","lineNumber":52,"isSignature":false},{"text":"","lineNumber":53,"isSignature":false},{"text":"\t// 2. Check for empty review body","lineNumber":54,"isSignature":false},{"text":"\tif reviewBody == \"\" {","lineNumber":55,"isSignature":false},{"text":"\t\treturn false","lineNumber":56,"isSignature":false},{"text":"\t}","lineNumber":57,"isSignature":false},{"text":"","lineNumber":58,"isSignature":false},{"text":"\t// 3. Detect approval patterns","lineNumber":59,"isSignature":false},{"text":"\t// Pattern 1: Regex match","lineNumber":60,"isSignature":false},{"text":"\tregexMatch := codexApprovalPattern.MatchString(reviewBody)","lineNumber":61,"isSignature":false},{"text":"\t// Pattern 2: Exact match (case-insensitive)","lineNumber":62,"isSignature":false},{"text":"\texactMatch := strings.EqualFold(strings.TrimSpace(reviewBody), codexApprovalExactMatch)","lineNumber":63,"isSignature":false},{"text":"","lineNumber":64,"isSignature":false},{"text":"\tdetected := regexMatch || exactMatch","lineNumber":65,"isSignature":false},{"text":"","lineNumber":66,"isSignature"