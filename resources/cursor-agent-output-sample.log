sly, each increment will be applied correctly without race conditions.\n    92|// The caller's agentRun parameter is updated with the latest data from the database upon return.\n    93|//\n    94|// Parameters:\n    95|//   - ctx: Context for cancellation and timeout control (reserved for future use)\n    96|//   - agentRun: AgentRun instance to update (must not be nil, must have valid ID).\n    97|//     The struct will be updated with the latest data from the database upon return.\n    98|//\n    99|// Returns:\n   100|//   - error: Error if validation fails, max retries already reached, or database update fails\n   101|func (r *RetryOrchestrator) IncrementRetryCount(ctx context.Context, agentRun *models.AgentRun) error {\n   102|\t// Parameter validation\n   103|\tif agentRun == nil\n   ...\n   186|// This is a helper method for convenience.\n   187|//\n   188|// Parameters:\n   189|//   - agentRun: AgentRun instance (nil safe, returns 0 if nil)\n   190|//\n   191|// Returns:\n   192|//   - int: Current retry count, or 0 if agentRun is nil\n   193|func (r *RetryOrchestrator) GetRetryCount(agentRun *models.AgentRun) int {\n   194|\tif agentRun == nil {\n   195|\t\treturn 0\n   196|\t}\n   197|\treturn agentRun.RetryCount\n   198|}\n   199|\n   200|// IsMaxRetriesReached checks if the maximum retry count has been reached for an AgentRun.\n   201|// Returns true if retry_count >= MaxRetryCount, false otherwise.\n   202|//\n   203|// Parameters:\n   204|//   - agentRun: AgentRun instance to check (nil safe, returns true if nil to indicate limit reached)\n   205|//\n   206|// Returns:\n   207|//   - bool: true if max retries reached, false otherwise\n   208|func (r *RetryOrchestrator) IsMaxRetriesReached(agentRun *models.AgentRun) bool {\n   209|\tif agentRun == nil {\n   210|\t\treturn true\n   211|\t}\n   212|\n   213|\tmaxReached := agentRun.RetryCount >= MaxRetryCount\n   214|\n   215|\tr.logger.Debug(\"Checking if max retries reached\",\n   216|\t\tzap.Int(\"agent_run_id\", agentRun.ID),\n   217|\t\tzap.Int(\"retry_count\", agentRun.RetryCount),\n   218|\t\tzap.Int(\"max_retry_count\", MaxRetryCount),\n   219|\t\tzap.Bool(\"max_reached\", maxReached),\n   220|\t\tzap.String(\"service\", \"retry_orchestrator\"),\n   221|\t)\n   222|\n   223|\treturn maxReached\n   224|}\n   225|\n   226|// ValidateRetryCount validates that the retry count is within acceptable bounds.\n   227|// Returns an error if retry_count < 0. Logs a warning if retry_count > MaxRetryCount\n   228|// but does not return an error (to allow existing exceeded counts).\n   229|//\n   230|// Parameters:\n   231|//   - agentRun: AgentRun instance to validate (must not be nil)\n   232|//\n   233|// Returns:\n   234|//   - error: Error if validation fails (retry_count < 0), nil otherwise\n   235|func (r *RetryOrchestrator) ValidateRetryCount(agentRun *models.AgentRun) error {\n   236|\t// Parameter validation\n   237|\tif agentRun == nil\n</search_result>\n<search_result path=\"specs/001-github-agent-automation/contracts/retry-decision-tree.md\" startLine=\"322\" endLine=\"407\">\n   322|**Example**:\n   323|```\n   324|AgentRun retry_count = 10\n   325|agent-runner reports to Operator (5 API retry attempts)\n   326|If all fail: retry_count becomes 11 (AI retry triggered)\n   327|```\n   328|\n   329|---\n   330|\n   331|## Implementation\n   332|\n   333|### RetryOrchestrator Service (internal/services/retry_orchestrator.go)\n   334|\n   335|```go\n   336|package services\n   337|\n   338|type RetryOrchestrator struct {\n   339|\tagentRunRepo AgentRunRepository\n   340|\tjobService   KubernetesJobService\n   341|}\n   342|\n   343|func (r *RetryOrchestrator) ShouldRetry(agentRun *AgentRun) bool {\n   344|\treturn agentRun.RetryCount < 50\n   345|}\n   346|\n   347|func (r *RetryOrchestrator) TriggerRetry(agentRun *AgentRun, feedback string) error {\n   348|\t// Increment retry count\n   349|\tagentRun.RetryCount++\n   350|\tif err := r.agentRunRepo.Update(agentRun); err != nil {\n   351|\t\treturn err\n   352|\t}\n   353|\n   354|\t// Check limit\n   355|\tif agentRun.RetryCount >= 50 {\n   356|\t\treturn r.handleMaxRetriesExceeded(agentRun)\n   357|\t}\n   358|\n   359|\t// Aggregate feedback and create new Job\n   360|\tprompt := r.buildRetryPrompt(agentRun, feedback)\n   361|\treturn r.jobService.CreateJob(agentRun, prompt)\n   362|}\n   363|\n   364|func (r *RetryOrchestrator) handleMaxRetriesExceeded(agentRun *AgentRun) error {\n   365|\tagentRun.State = \"failed\"\n   366|\t// Post GitHub comment\n   367|\t// Send Discord notification\n   368|\treturn r.agentRunRepo.Update(agentRun)\n   369|}\n   370|```\n   371|\n   372|---\n   373|\n   374|## Edge Cases\n   375|\n   376|### 1. Same Error Repeated 3 Times\n   377|\n   378|**Problem**: Agent stuck in infinite loop with same error\n   379|\n   380|**Detection**:\n   381|- Hash of (error_message + ci_logs + review_comments)\n   382|- If hash matches previous 3 consecutive attempts → pause\n   383|\n   384|**Action**:\n   385|- Post GitHub comment: \"⚠️ Same error detected 3 times. Pausing auto-retry. Please review.\"\n   386|- Do NOT increment retry_count\n   387|- Require manual reset via CLI: `operator retry <run-id> --reset-count`\n   388|\n   389|---\n   390|\n   391|### 2. Partial Success (Lint Passed, CI Failed Later)\n   392|\n   393|**Problem**: Should retry count include partial successes?\n   394|\n   395|**Answer**: Yes, any failure triggers +1 increment\n   396|\n   397|**Reason**: The goal is to reach fully working code, not partial progress\n   398|\n   399|---\n   400|\n   401|### 3. Codex Never Responds\n   402|\n   403|**Problem**: PR created, but Codex bot never posts review\n   404|\n   405|**Action**:\n   406|- Spec requires **manual intervention** (FR-010 clarification)\n   407|- System does NOT poll for Codex response\n</search_result>\n<search_result path=\"specs/001-github-agent-automation/tasks.md\" startLine=\"199\" endLine=\"229\">\n   199|- [x] T096 [US3] Implement retry orchestrator managing retry_count (max 50) in internal/services/retry_orchestrator.go\n   200|- [x] T097 [US3] Create feedback aggregator combining review + CI results in internal/services/feedback_aggregator.go\n   201|- [x] T098 [US3] Implement K8s Job re-creation with aggregated feedback for AI retry in internal/services/kubernetes_job.go\n   202|- [x] T099 [US3] Add retry count validation and failure threshold (50) in internal/services/retry_orchestrator.go\n   203|- [x] T100 [US3] Implement failure notification to GitHub Issue on max retries in internal/services/github_notification.go\n   204|- [x] T101 [US3] Implement failure notification to Discord webhook on max retries in internal/services/discord_notification.go\n   205|- [x] T102 [US3] Add GitHub status comment updates for retry progress in internal/services/github_notification.go\n   206|- [x] T103 [US3] Store ReviewFeedback records for each review cycle in internal/repositories/review_feedback.go\n   207|\n   208|### Tests for User Story 3 (Test-First Development)\n   209|\n   210|- [ ] T104 [P] [US3] Write unit tests for CodexApprovalDetector (approval pattern matching)\n   211|- [ ] T105 [P] [US3] Write unit tests for RetryOrchestrator (max 50 retries logic)\n   212|- [ ] T106 [P] [US3] Write unit tests for FeedbackAggregator (review + CI combination)\n   213|- [ ] T107 [US3] Write integration test for CI failure → retry → success flow\n   214|\n   215|**Checkpoint**: All user stories 1-3 should now be independently functional - quality loop with automatic improvements\n   216|\n   217|---\n   218|\n   219|## Phase 6: User Story 4 - Approveと自動マージ (Priority: P2)\n   220|\n   221|**Goal**: PR が承認状態 (CI success + Codex approve + no conflicts) になったら自動でマージする\n   222|\n   223|**Independent Test**: PR に Approve を付与すると自動でマージされること\n   224|\n   225|### Implementation for User Story 4\n   226|\n   227|- [ ] T108 [P] [US4] Implement merge condition checker (CI + Codex + conflicts) i