ignature":false},{"text":"**Relationships**:","lineNumber":40,"isSignature":false},{"text":"- has many ReviewFeedback","lineNumber":41,"isSignature":false},{"text":"- has many CIStatus","lineNumber":42,"isSignature":false},{"text":"- belongs to Issue (optional, via issue_id)","lineNumber":43,"isSignature":false},{"text":"- has many AgentRun (one PR can have multiple retry attempts)","lineNumber":44,"isSignature":false},{"text":"","lineNumber":45,"isSignature":false},{"text":"**Indexes**:","lineNumber":46,"isSignature":false},{"text":"- UNIQUE(repo, number)","lineNumber":47,"isSignature":false},{"text":"- INDEX(issue_id) - for querying PRs by Issue","lineNumber":48,"isSignature":false},{"text":"","lineNumber":49,"isSignature":false},{"text":"### AgentRun","lineNumber":50,"isSignature":false},{"text":"- id: INT (PK, auto-increment)","lineNumber":51,"isSignature":false},{"text":"- idempotency_key: STRING (UK) - **X-GitHub-Delivery header for deduplication**","lineNumber":52,"isSignature":false},{"text":"- issue_id: INT (FK to Issue.id) - **NEW**: which Issue is being processed","lineNumber":53,"isSignature":false},{"text":"- pr_id: INT (FK to PullRequest.id, nullable) - PR created by this run","lineNumber":54,"isSignature":false},{"text":"- state: ENUM(queued/started/succeeded/failed)","lineNumber":55,"isSignature":false},{"text":"- agent_type: ENUM(claude-code/cursor-agent) - **NEW**: Which AI agent was used","lineNumber":56,"isSignature":false},{"text":"- input: JSON (Issue context, comments, dependencies, **manifest config**)","lineNumber":57,"isSignature":false},{"text":"- output: JSON (AI agent response, changes made)","lineNumber":58,"isSignature":false},{"text":"- retry_count: INT (default: 0, max: 50)","lineNumber":59,"isSignature":false}]},"score":0.2240796983242035},{"codeBlock":{"relativeWorkspacePath":"internal/models/pull_request.go","range":{"startPosition":{"line":0,"column":0},"endPosition":{"line":29,"column":1}},"contents":"package models\n\nimport (\n\t\"time\"\n)\n\n// PullRequest represents a GitHub Pull Request\ntype PullRequest struct {\n\tID         int       `gorm:\"primaryKey;autoIncrement\"`\n\tRepo       string    `gorm:\"size:255;index:idx_pr_repo_number,unique\"`\n\tNumber     int       `gorm:\"index:idx_pr_repo_number,unique\"`\n\tIssueID    *int      `gorm:\"column:issue_id;index\"`\n\tBranch     string    `gorm:\"size:255\"`\n\tBaseBranch string    `gorm:\"column:base_branch;size:255;default:'main'\"`\n\tStatus     string    `gorm:\"type:enum('open','closed','merged');default:'open'\"`\n\tMergeable  *bool     `gorm:\"type:boolean\"`\n\tCreatedAt  time.Time `gorm:\"column:created_at;autoCreateTime\"`\n\tUpdatedAt  time.Time `gorm:\"column:updated_at;autoUpdateTime\"`\n\n\t// Relationships\n\tIssue          *Issue           `gorm:\"foreignKey:IssueID;constraint:OnDelete:SET NULL\"`\n\tReviewFeedback []ReviewFeedback `gorm:\"foreignKey:PRID;constraint:OnDelete:CASCADE\"`\n\tCIStatuses     []CIStatus       `gorm:\"foreignKey:PRID;constraint:OnDelete:CASCADE\"`\n\tAgentRuns      []AgentRun       `gorm:\"foreignKey:PRID;constraint:OnDelete:SET NULL\"`\n}\n\n// TableName specifies the table name for PullRequest\nfunc (PullRequest) TableName() string {\n\treturn \"pull_requests\"\n}","signatures":{"ranges":[]},"detailedLines":[{"text":"package models","lineNumber":1,"isSignature":false},{"text":"","lineNumber":2,"isSignature":false},{"text":"import (","lineNumber":3,"isSignature":false},{"text":"\t\"time\"","lineNumber":4,"isSignature":false},{"text":")","lineNumber":5,"isSignature":false},{"text":"","lineNumber":6,"isSignature":false},{"text":"// PullRequest represents a GitHub Pull Request","lineNumber":7,"isSignature":false},{"text":"type PullRequest struct {","lineNumber":8,"isSignature":false},{"text":"\tID         int       `gorm:\"primaryKey;autoIncrement\"`","lineNumber":9,"isSignature":false},{"text":"\tRepo       string    `gorm:\"size:255;index:idx_pr_repo_number,unique\"`","lineNumber":10,"isS