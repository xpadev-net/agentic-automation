{"type":"tool_call","subtype":"completed","call_id":"tool_0f605fe8-af16-4051-98f3-84ad0f4f634","tool_call":{"semSearchToolCall":{"args":{"query":"CodexApprovalDetector unit tests","targetDirectories":[],"explanation":""},"result":{"success":{"results":"<search_result path=\"internal/services/codex_approval.go\" startLine=\"2\" endLine=\"83\">\n     2|package services\n     3|\n     4|import (\n     5|\t\"agentic-automation/internal/config\"\n     6|\t\"regexp\"\n     7|\t\"strings\"\n     8|\n     9|\t\"go.uber.org/zap\"\n    10|)\n    11|\n    12|// codexApprovalPattern is a compiled regex pattern to detect Codex approval messages.\n    13|// Pattern matches \"didn't find.*major issues\" (case-insensitive).\n    14|var codexApprovalPattern = regexp.MustCompile(`(?i)didn't find.*major issues`)\n    15|\n    16|// codexApprovalExactMatch is the exact approval message from Codex bot.\n    17|const codexApprovalExactMatch = \"Codex Review: Didn't find any major issues.\"\n    18|\n    19|// CodexApprovalDetector detects Codex bot approval patterns in review comments.\n    20|type CodexApprovalDetector struct {\n    21|\tlogger           *zap.Logger\n    22|\tcodexBotUsername string\n    23|}\n    24|\n    25|// NewCodexApprovalDetector creates a new CodexApprovalDetector instance.\n    26|// If logger is nil, it uses config.GetLogger().\n    27|// The Codex bot username is read from CODEX_BOT_USERNAME environment variable (default: \"codex-bot\").\n    28|func NewCodexApprovalDetector(logger *zap.Logger) *CodexApprovalDetector {\n    29|\tif logger == nil {\n    30|\t\tlogger = config.GetLogger()\n    31|\t}\n    32|\n    33|\treturn &CodexApprovalDetector{\n    34|\t\tlogger:           logger,\n    35|\t\tcodexBotUsername: config.GetEnv(\"CODEX_BOT_USERNAME\", \"codex-bot\"),\n    36|\t}\n    37|}\n    38|\n    39|// DetectApproval checks if the review comment contains a Codex approval pattern.\n    40|// It validates that the reviewer is the Codex bot and checks for approval patterns:\n    41|// - Regex pattern: \"didn't find.*major issues\" (case-insensitive)\n    42|// - Exact match: \"Codex Review: Didn't find any major issues.\" (case-insensitive)\n    43|//\n    44|// Returns true if approval is detected, false otherwise.\n    45|// Logs the detection result at Info level with approval_detected, reviewer_username,\n    46|// and review_body_preview fields. The review_body_preview is limited to the first 100 characters\n    47|// for security purposes.\n    48|func (s *CodexApprovalDetector) DetectApproval(reviewBody string, reviewerUsername string) bool {\n    49|\t// 1. Validate reviewer username (case-insensitive)\n    50|\tif !strings.EqualFold(reviewerUsername, s.codexBotUsername) {\n    51|\t\treturn false\n    52|\t}\n    53|\n    54|\t// 2. Check for empty review body\n    55|\tif reviewBody == \"\" {\n    56|\t\treturn false\n    57|\t}\n    58|\n    59|\t// 3. Detect approval patterns\n    60|\t// Pattern 1: Regex match\n    61|\tregexMatch := codexApprovalPattern.MatchString(reviewBody)\n    62|\t// Pattern 2: Exact match (case-insensitive)\n    63|\texactMatch := strings.EqualFold(strings.TrimSpace(reviewBody), codexApprovalExactMatch)\n    64|\n    65|\tdetected := regexMatch || exactMatch\n    66|\n    67|\t// 4. Log the detection result\n    68|\t// Create preview of review body (first 100 characters for security)\n    69|\tpreview := reviewBody\n    70|\tif len(preview) > 100 {\n    71|\t\tpreview = preview[:100]\n    72|\t}\n    73|\n    74|\ts.logger.Info(\"Codex approval detection result\",\n    75|\t\tzap.Bool(\"approval_detected\", detected),\n    76|\t\tzap.String(\"reviewer_username\", reviewerUsername),\n    77|\t\tzap.String(\"review_body_preview\", preview),\n    78|\t\tzap.String(\"service\", \"codex_approval\"),\n    79|\t)\n    80|\n    81|\t// 5. Return detection result\n    82|\treturn detected\n    83|}\n</search_result>\n<search_result path=\"tests/unit/repositories/review_feedback_test.go\"