ure":false},{"text":"    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,","lineNumber":116,"isSignature":false},{"text":"","lineNumber":117,"isSignature":false},{"text":"    PRIMARY KEY pk_blocker_graph (task_id, depends_on_task_id),","lineNumber":118,"isSignature":false},{"text":"    INDEX idx_blocker_depends_on (depends_on_task_id),","lineNumber":119,"isSignature":false},{"text":"    FOREIGN KEY fk_blocker_task (task_id) REFERENCES issues(id) ON DELETE CASCADE,","lineNumber":120,"isSignature":false},{"text":"    FOREIGN KEY fk_blocker_depends (depends_on_task_id) REFERENCES issues(id) ON DELETE CASCADE","lineNumber":121,"isSignature":false},{"text":") ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;","lineNumber":122,"isSignature":false},{"text":"","lineNumber":123,"isSignature":false},{"text":"-- Table: audit_logs","lineNumber":124,"isSignature":false},{"text":"CREATE TABLE IF NOT EXISTS audit_logs (","lineNumber":125,"isSignature":false},{"text":"    id INT AUTO_INCREMENT PRIMARY KEY,","lineNumber":126,"isSignature":false},{"text":"    event_type VARCHAR(191) NOT NULL,","lineNumber":127,"isSignature":false}]},"score":0.2901534140110016},{"codeBlock":{"relativeWorkspacePath":"specs/001-github-agent-automation/tasks.md","range":{"startPosition":{"line":317,"column":0},"endPosition":{"line":383,"column":0}},"contents":"**Note**: US1 and US5 are relatively independent; US2→US3→US4 form a sequential enhancement chain.\n\n### Within Each User Story\n\n- Models before services (repositories depend on models)\n- Core services before orchestrators\n- Webhook handlers integrate existing services\n- Notification services are last in each phase\n\n### Parallel Opportunities\n\n**Setup Phase (Phase 1):**\n- T003, T004, T005, T006, T007 can all run in parallel\n\n**Foundational Phase (Phase 2):**\n- T008-T010 must run sequentially (GORM models/DB init → goose migration)\n- T011-T015 (all repositories) can run in parallel after DB setup\n- T017-T019 (all API clients) can run in parallel\n- T021-T023 (logging, retry, config) can run in parallel\n\n**User Story 1 (Phase 3):**\n- T025, T026 can run in parallel\n- T034 (notifications) independent of core flow\n\n**User Story 2 (Phase 4):**\n- T035, T036 can run in parallel\n\n**User Story 3 (Phase 5):**\n- T046, T047 can run in parallel\n- Review and CI handling are parallel concerns\n\n**User Story 4 (Phase 6):**\n- T060, T061 can run in parallel\n\n**User Story 5 (Phase 7):**\n- T104, T105 can run in parallel\n\n**Polish Phase (Phase 8):**\n- Almost all tasks marked [P] can run in parallel (T081-T107, T110-T111)\n\n**Once Foundational phase completes:**\n- US1 can start immediately\n- US5 can start in parallel with US1 (independent)\n- US2-US4 form a sequential chain but different developers can work ahead with stubs\n\n---\n\n## Parallel Example: User Story 2\n\n```bash\n# Launch API clients in parallel (after DB setup):\nTask: \"T035 - Create AI agent client interface in src/lib/ai-agent-client.ts\"\nTask: \"T036 - Implement Git operations wrapper in src/lib/git-operations.ts\"\n\n# After AI integration is ready, these can be parallelized:\nTask: \"T040 - Implement commit message generator from AI output in src/utils/commit-message-generator.ts\"\nTask: \"T043 - Implement error handling for Git operation failures in src/services/AgentExecutionService.ts\"\n```\n\n---\n\n## Implementation Strategy\n\n### MVP First (User Stories 1 + 2 Only)","signatures":{"ranges":[]},"detailedLines":[{"text":"**Note**: US1 and US5 are relatively independent; US2→US3→US4 form a sequential enhancement chain.","lineNumber":319,"isSignature":false},{"text":"","lineNumber":320,"isSignature":false},{"text":"### Within Each User Story","lineNumber":321,"isSignature":false},{"text":"","lineNumber":322,"isSignature":false},{"text":"- Models before services (repositories depend on models)","lineNumber":323,"isSignature":false},{"text":"- Core services before orchestrators","lineNumber":324,"isSignature":false},{"text":"- Webhook handlers integrate existing services","lineNumber":325,"isSignature":false},{"text":"- Notification services are last in each phase","lineNumber":326,"isSignature":false},{"text":"","lineNumber":327,"isSignature":false},{"text":"### Parallel Opportunities","lineNumber":328,"isSignature":false},{"text":"","lineNumber":329,"isSignature":false},{"text":"**Setup Phase (Phase 1):**","lineNumber":330,"isSignature":false},{"text":"- T003, T004, T005, T006, T007 can all run in parallel","lineNumber":331,"isSignature":false},{"text":"","lineNumber":332,"isSignature":false},{"text":"**Foundational Phase (Phase 2):**","lineNumber":333,"isSignature":false},{"text":"- T008-T010 must run sequentially (GORM models/DB init → goose migration)","lineNumber":334,"isSignature":false},{"text":"- T011-T015 (all repositories) can run in parallel after DB setup","lineNumber":335,"isSignature":false},{"text":"- T017-T019 (all API clients) can run in parallel","lineNumber":336,"isSignature":false},{"text":"- T021-T023 (logging, retry, config) can run in parallel","lineNumber":337,"isSignature":false},{"text":"","lineNumber":338,"isSignature":false},{"text":"**User Story 1 (Phase 3):**","lineNumber":339,"isSignature":false},{"text":"- T025, T026 can run in parallel","lineNumber":340,"isSignature":false},{"text":"- T034 (notifications) independent of core flow","lineNumber":341,"isSignature":false},{"text":"","lineNumber":342,"isSignature":false},{"text":"**User Story 2 (Phase 4):**","lineNumber":343,"isSignature":false},{"text":"- T035, T036 can run in parallel","lineNumber":344,"isSignature":false},{"text":"","lineNumber":345,"isSignature":false},{"text":"**User Story 3 (Phase 5):**","lineNumber":346,"isSignature":false},{"text":"- T046, T047 can run in parallel","lineNumber":347,"isSignature":false},{"text":"- Review and CI handling are parallel concerns","lineNumber":348,"isSignature":false},{"text":"","lineNumber":349,"isSignature":false},{"text":"**User Story 4 (Phase 6):**","lineNumber":350,"isSignature":false},{"text":"- T060, T061 can run in parallel","lineNumber":351,"isSignature":false},{"text":"","lineNumber":352,"isSignature":false},{"text":"**User Story 5 (Phase 7):**","lineNumber":353,"isSignature":false},{"text":"- T104, T105 can run in parallel","lineNumber":354,"isSignature":false},{"text":"","lineNumber":355,"isSignature":false},{"text":"**Polish Phase (Phase 8):**","lineNumber":356,"isSignature":false},{"text":"- Almost all tasks marked [P] can run in parallel (T081-T107, T110-T111)","lineNumber":357,"isSignature":false},{"text":"","lineNumber":358,"isSignature":false},{"text":"**Once Foundational phase completes:**","lineNumber":359,"isSignature":false},{"text":"- US1 can start immediately","lineNumber":360,"isSignature":false},{"text":"- US5 can start in parallel with US1 (independent)","lineNumber":361,"isSignature":false},{"text":"- US2-US4 form a sequential chain but different developers can work ahead with stubs","lineNumber":362,"isSignature":false},{"text":"","lineNumber":363,"isSignature":false},{"text":"---","lineNumber":364,"isSignature":false},{"text":"","lineNumber":365,"isSignature":false},{"text":"## Parallel Example: User Story 2","lineNumber":366,"isSignature":false},{"text":"","lineNumber":367,"isSignature":false},{"text":"```bash","lineNumber":368,"isSignature":false},{"text":"# Launch API clients in parallel (after DB setup):","lineNumber":369,"isSignature":false},{"text":"Task: \"T035 - Create AI agent client interface in src/lib/ai-agent-client.ts\"","lineNumber":370,"isSignature":false},{"text":"Task: \"T036 - Implement Git operations wrapper in src/lib/git-operations.ts\"","lineNumber":371,"isSignature":false},{"text":"","lineNumber":372,"isSignature":false},{"text":"# After AI integration is ready, these can be parallelized:","lineNumber":373,"isSignature":false},{"text":"Task: \"T040 - Implement commit message generator from AI output in src/utils/commit-message-generator.ts\"","lineNumber":374,"isSignature":false},{"text":"Task: \"T043 - Implement error handling for Git operation failures in src/services/AgentExecutionService.ts\"","lineNumber":375,"isSignature":false},{"text":"```","lineNumber":376,"isSignature":false},{"text":"","lineNumber":377,"isSignature":false},{"text":"---","lineNumber":378,"isSignature":false},{"text":"","lineNumber":379,"isSignature":false},{"text":"## Implementation Strategy","lineNumber":380,"isSignature":false},{"text":"","lineNumber":381,"isSignature":false},{"text":"### MVP First (User Stories 1 + 2 Only)","lineNumber":382,"isSignature":false}]},"score":0.29003816843032837},{"codeBlock":{"relativeWorkspacePath":"specs/001-github-agent-automation/spec.md","range":{"startPosition":{"line":103,"column":0},"endPosition":{"line":136,"column":0}},"contents":"**Independent Test**: 依存関係グラフでブロック解消時に次タスク実行が開始されること。\n\n**Acceptance Scenarios**:\n1. Given タスクB がタスクA に依存 When タスクA が完了 Then タスクB の実行が開始される\n2. Given 循環依存 When 完了処理 Then タスク開始は行われず警告が記録される\n\n### Edge Cases\n\n- GitHub Webhook の再送（重複イベント）\n- レビュー応答が欠落・遅延する場合（手動対応を前提）\n- マージ競合・保護ブランチ条件での失敗\n- 無制限同時実行時の競合（同一ファイル衝突、重複 PR）\n\n- 外部API障害時はエラー記録・通知し、指数バックオフ+ジッターで設定した上限回数までリトライする。上限到達時は失敗として通知する。\n- Codex レビュー応答が取得できない場合は手動対応とし、システムは追加のポーリングやハング防止処理を行わない。\n\n- 同一ブランチに対する同時実行は 1 に制限（per-branch concurrency = 1）\n\n## Requirements (mandatory)\n\n### Functional Requirements\n\n- FR-001: システムはトリガ文字列を含む Issue コメント受信時に実行を開始する (MUST)\n- FR-002: 実行コンテキストは Issue 本文・コメント・関連 PR/コミットを収集する (MUST)\n- FR-003: 変更は新規ブランチでコミット・プッシュし PR を作成する (MUST)\n- FR-004: 作成 PR を Codex にレビュー依頼し結果を保存する (MUST)\n- FR-005: レビュー結果を AI に再入力し再試行コミットを作成する (MUST)\n- FR-006: PR が Approve 状態を満たした場合に自動マージする (MUST)\n- FR-007: タスク依存グラフを管理しブロック解消で次タスクを開始する (MUST)\n- FR-008: すべての外部操作は冪等に設計し重複イベントを安全に処理する (MUST)\n\n- FR-009: トリガはコメント本文に「/run-agent」を含む場合のみ有効とし、コメント投稿者\n  は当該リポジトリの書き込み権限メンバーに限定する。またコメントの編集・削除イベントは無視する。書き込み権限があれば一律許可とし、必ずデフォルトブランチから派生ブランチを作成して作業する (MUST)","signatures":{"ranges":[]},"detailedLines":[{"text":"**Independent Test**: 依存関係グラフでブロック解消時に次タスク実行が開始されること。","lineNumber":104,"isSignature":false},{"text":"","lineNumber":105,"isSignature":false},{"text":"**Acceptance Scenarios**:","lineNumber":106,"isSignature":false},{"text":"1. Given タスクB がタスクA に依存 When タスクA が完了 Then タスクB の実行が開始される","lineNumber":107,"isSignature":false},{"text":"2. Given 循環依存 When 完了処理 Then タスク開始は行われず警告が記録される","lineNumber":108,"isSignature":false},{"text":"","lineNumber":109,"isSignature":false},{"text":"### Edge Cases","lineNumber":110,"isSignature":false},{"text":"","lineNumber":111,"isSignature":false},{"text":"- GitHub Webhook の再送（重複イベント）","lineNumber":112,"isSignature":false},{"text":"- レビュー応答が欠落・遅延する場合（手動対応を前提）","lineNumber":113,"isSignature":false},{"text":"- マージ競合・保護ブランチ条件での失敗","lineNumber":114,"isSignature":false},{"text":"- 無制限同時実行時の競合（同一ファイル衝突、重複 PR）","lineNumber":115,"isSignature":false},{"text":"","lineNumber":116,"isSignature":false},{"text":"- 外部API障害時はエラー記録・通知し、指数バックオフ+ジッターで設定した上限回数までリトライする。上限到達時は失敗として通知する。","lineNumber":117,"isSignature":false},{"text":"- Codex レビュー応答が取得できない場合は手動対応とし、システムは追加のポーリングやハング防止処理を行わない。","lineNumber":118,"isSignature":false},{"text":"","lineNumber":119,"isSignature":false},{"text":"- 同一ブランチに対する同時実行は 1 に制限（per-branch concurrency = 1）","lineNumber":120,"isSignature":false},{"text":"","lineNumber":121,"isSignature":false},{"text":"## Requirements (mandatory)","lineNumber":122,"isSignature":false},{"text":"","lineNumber":123,"isSignature":false},{"text":"### Functional Requirements","lineNumber":124,"isSignature":false},{"text":"","lineNumber":125,"isSignature":false},{"text":"- FR-001: システムはトリガ文字列を含む Issue コメント受信時に実行を開始する (MUST)","lineNumber":126,"isSignature":false},{"text":"- FR-002: 実行コンテキストは Issue 本文・コメント・関連 PR/コミットを収集する (MUST)","lineNumber":127,"isSignature":false},{"text":"- FR-003: 変更は新規ブランチでコミット・プッシュし PR を作成する (MUST)","lineNumber":128,"isSignature":false},{"text":"- FR-004: 作成 PR を Codex にレビュー依頼し結果を保存する (MUST)","lineNumber":129,"isSignature":false},{"text":"- FR-005: レビュー結果を AI に再入力し再試行コミットを作成する (MUST)","lineNumber":130,"isSignature":false},{"text":"- FR-006: PR が Approve 状態を満たした場合に自動マージする (MUST)","lineNumber":131,"isSignature":false},{"text":"- FR-007: タスク依存グラフを管理しブロック解消で次タスクを開始する (MUST)","lineNumber":132,"isSignature":false},{"text":"- FR-008: すべての外部操作は冪等に設計し重複イベントを安全に処理する (MUST)","lineNumber":133,"isSignature":false},{"text":"","lineNumber":134,"isSignature":false},{"text":"- FR-009: トリガはコメント本文に「/run-agent」を含む場合のみ有効とし、コメント投稿者","lineNumber":135,"isSignature":false},{"text":"  は当該リポジトリの書き込み権限メンバーに限定する。またコメントの編集・削除イベントは無視する。書き込み権限があれば一律許可とし、必ずデフォルトブランチから派生ブランチを作成して作業する (MUST)","lineNumber":136,"isSignature":false}]},"score":0.27532005310058594},{"codeBlock":{"relativeWorkspacePath":".specify/templates/tasks-template.md","range":{"startPosition":{"line":165,"column":0},"endPosition":{"line":217,"column":0}},"contents":"- **Setup (Phase 1)**: No dependencies - can start immediately\n- **Foundational (Phase 2)**: Depends on Setup completion - BLOCKS all user stories\n- **User Stories (Phase 3+)**: All depend on Foundational phase completion\n  - User stories can then proceed in parallel (if staffed)\n  - Or sequentially in priority order (P1 → P2 → P3)\n- **Polish (Final Phase)**: Depends on all desired user stories being complete\n\n### User Story Dependencies\n\n- **User Story 1 (P1)**: Can start after Foundational (Phase 2) - No dependencies on other stories\n- **User Story 2 (P2)**: Can start after Foundational (Phase 2) - May integrate with US1 but should be independently testable\n- **User Story 3 (P3)**: Can start after Foundational (Phase 2) - May integrate with US1/US2 but should be independently testable\n\n### Within Each User Story\n\n- Tests (if included) MUST be written and FAIL before implementation\n- Models before services\n- Services before endpoints\n- Core implementation before integration\n- Story complete before moving to next priority\n\n### Parallel Opportunities\n\n- All Setup tasks marked [P] can run in parallel\n- All Foundational tasks marked [P] can run in parallel (within Phase 2)\n- Once Foundational phase completes, all user stories can start in parallel (if team capacity allows)\n- All tests for a user story marked [P] can run in parallel\n- Models within a story marked [P] can run in parallel\n- Different user stories can be worked on in parallel by different team members\n\n---\n\n## Parallel Example: User Story 1\n\n```bash\n# Launch all tests for User Story 1 together (if tests requested):\nTask: \"Contract test for [endpoint] in tests/contract/test_[name].py\"\nTask: \"Integration test for [user journey] in tests/integration/test_[name].py\"\n\n# Launch all models for User Story 1 together:\nTask: \"Create [Entity1] model in src/models/[entity1].py\"\nTask: \"Create [Entity2] model in src/models/[entity2].py\"\n```\n\n---\n\n## Implementation Strategy\n\n### MVP First (User Story 1 Only)\n\n1. Complete Phase 1: Setup\n2. Complete Phase 2: Foundational (CRITICAL - blocks all stories)","signatures":{"ranges":[]},"detailedLines":[{"text":"- **Setup (Phase 1)**: No dependencies - can start immediately","lineNumber":166,"isSignature":false},{"text":"- **Foundational (Phase 2)**: Depends on Setup completion - BLOCKS all user stories","lineNumber":167,"isSignature":false},{"text":"- **User Stories (Phase 3+)**: All depend on Foundational phase completion","lineNumber":168,"isSignature":false},{"text":"  - User stories can then proceed in parallel (if staffed)","lineNumber":169,"isSignature":false},{"text":"  - Or sequentially in priority order (P1 → P2 → P3)","lineNumber":170,"isSignature":false},{"text":"- **Polish (Final Phase)**: Depends on all desired user stories being complete","lineNumber":171,"isSignature":false},{"text":"","lineNumber":172,"isSignature":false},{"text":"### User Story Dependencies","lineNumber":173,"isSignature":false},{"text":"","lineNumber":174,"isSignature":false},{"text":"- **User Story 1 (P1)**: Can start after Foundational (Phase 2) - No dependencies on other stories","lineNumber":175,"isSignature":false},{"text":"- **User Story 2 (P2)**: Can start after Foundational (Phase 2) - May integrate with US1 but should be independently testable","lineNumber":176,"isSignature":false},{"text":"- **User Story 3 (P3)**: Can start after Foundational (Phase 2) - May integrate with US1/US2 but should be independently testable","lineNumber":177,"isSignature":false},{"text":"","lineNumber":178,"isSignature":false},{"text":"### Within Each User Story","lineNumber":179,"isSignature":false},{"text":"","lineNumber":180,"isSignature":false},{"text":"- Tests (if included) MUST be written and FAIL before implementation","lineNumber":181,"isSignature":false},{"text":"- Models before services","lineNumber":182,"isSignature":false},{"text":"- Services before endpoints","lineNumber":183,"isSignature":false},{"text":"- Core implementation before integration","lineNumber":184,"isSignature":false},{"text":"- Story complete before moving to next priority","lineNumber":185,"isSignature":false},{"text":"","lineNumber":186,"isSignature":false},{"text":"### Parallel Opportunities","lineNumber":187,"isSignature":false},{"text":"","lineNumber":188,"isSignature":false},{"text":"- All Setup tasks marked [P] can run in parallel","lineNumber":189,"isSignature":false},{"text":"- All Foundational tasks marked [P] can run in parallel (within Phase 2)","lineNumber":190,"isSignature":false},{"text":"- Once Foundational phase completes, all user stories can start in parallel (if team capacity allows)","lineNumber":191,"isSignature":false},{"text":"- All tests for a user story marked [P] can run in parallel","lineNumber":192,"isSignature":false},{"text":"- Models within a story marked [P] can run in parallel","lineNumber":193,"isSignature":false},{"text":"- Different user stories can be worked on in parallel by different team members","lineNumber":194,"isSignature":false},{"text":"","lineNumber":195,"isSignature":false},{"text":"---","lineNumber":196,"isSignature":false},{"text":"","lineNumber":197,"isSignature":false},{"text":"## Parallel Example: User Story 1","lineNumber":198,"isSignature":false},{"text":"","lineNumber":199,"isSignature":false},{"text":"```bash","lineNumber":200,"isSignature":false},{"text":"# Launch all tests for User Story 1 together (if tests requested):","lineNumber":201,"isSignature":false},{"text":"Task: \"Contract test for [endpoint] in tests/contract/test_[name].py\"","lineNumber":202,"isSignature":false},{"text":"Task: \"Integration test for [user journey] in tests/integration/test_[name].py\"","lineNumber":203,"isSignature":false},{"text":"","lineNumber":204,"isSignature":false},{"text":"# Launch all models for User Story 1 together:","lineNumber":205,"isSignature":false},{"text":"Task: \"Create [Entity1] model in src/models/[entity1].py\"","lineNumber":206,"isSignature":false},{"text":"Task: \"Create [Entity2] model in src/models/[entity2].py\"","lineNumber":207,"isSignature":false},{"text":"```","lineNumber":208,"isSignature":false},{"text":"","lineNumber":209,"isSignature":false},{"text":"---","lineNumber":210,"isSignature":false},{"text":"","lineNumber":211,"isSignature":false},{"text":"## Implementation Strategy","lineNumber":212,"isSignature":false},{"text":"","lineNumber":213,"isSignature":false},{"text":"### MVP First (User Story 1 Only)","lineNumber":214,"isSignature":false},{"text":"","lineNumber":215,"isSignature":false},{"text":"1. Complete Phase 1: Setup","lineNumber":216,"isSignature":false},{"text":"2. Complete Phase 2: Foundational (CRITICAL - blocks all stories)","lineNumber":217,"isSignature":false}]},"score":0.2711057662963867},{"codeBlock":{"relativeWorkspacePath":"specs/001-github-agent-automation/spec.md","range":{"startPosition":{"line":176,"column":0},"endPosition":{"line":219,"column":0}},"contents":"  - FR refs: FR-011, FR-015\n\n- pull_request_review_comment\n  - Purpose: PR 上の `@codex review` 検知による再レビュー依頼トリガ\n  - Actions: 権限検証の上でレビュー依頼コメント投稿、ReviewFeedback の更新\n  - FR refs: FR-010, FR-017\n\n- check_suite / check_run / status\n  - Purpose: PR のコミットに対する CI 結果の追跡\n  - Actions: 失敗時は AI へのフィードバックと再試行、成功時はマージ条件再評価\n  - FR refs: FR-014, FR-015\n\n- push\n  - Purpose: 再試行コミット（追加コミット）の検知、PR head SHA 更新に伴う評価\n  - FR refs: FR-005, FR-014, FR-021\n\n- issues\n  - Purpose: 依存関係グラフの更新とブロック解除検知（closed/reopened）\n  - Actions: BlockerGraph の更新、ブロック解除時の AgentRun 起動\n  - FR refs: FR-007, FR-013\n\n- workflow_run（必要に応じて）\n  - Purpose: 再利用ワークフロー等で check_* が発火しない CI の代替フック\n  - Actions: 上記 CI 追跡と同等に扱う（check_* が利用できない場合のみ）\n  - FR refs: FR-014\n\n### Key Entities (include if feature involves data)\n\n- Issue: ID, タイトル, 本文, ラベル, コメント\n- PullRequest: ID, ブランチ, ステータス, レビュー, マージ状態\n- AgentRun: 状態(queued/started/succeeded/failed), 入力, 出力, リンク(PR/コミット), リトライ回数(最大50), github_event_id(X-GitHub-Delivery)\n- ReviewFeedback: 出所(Codex), 内容, ステータス, タイムスタンプ\n- BlockerGraph: タスクと依存関係の有向グラフ\n\n#### Glossary\n\n- **AI**: Issueをもとにコーディングを行うAIエージェントとして本仕様全体で統一する。\n\n#### MySQL Constraints (sketch)\n\n- AgentRun: PK(id), UK(idempotency_key=X-GitHub-Delivery), state ENUM(queued,started,succeeded,failed), pr_id(FK: PullRequest.id, NULL 可), created_at, updated_at\n- ReviewFeedback: PK(id), pr_id(FK: PullRequest.id), source ENUM(Codex), created_at, updated_at\n- PullRequest: PK(id), repo, number, branch, status, mergeable, created_at, updated_at","signatures":{"ranges":[]},"detailedLines":[{"text":"  - FR refs: FR-011, FR-015","lineNumber":177,"isSignature":false},{"text":"","lineNumber":178,"isSignature":false},{"text":"- pull_request_review_comment","lineNumber":179,"isSignature":false},{"text":"  - Purpose: PR 上の `@codex review` 検知による再レビュー依頼トリガ","lineNumber":180,"isSignature":false},{"text":"  - Actions: 権限検証の上でレビュー依頼コメント投稿、ReviewFeedback の更新","lineNumber":181,"isSignature":false},{"text":"  - FR refs: FR-010, FR-017","lineNumber":182,"isSignature":false},{"text":"","lineNumber":183,"isSignature":false},{"text":"- check_suite / check_run / status","lineNumber":184,"isSignature":false},{"text":"  - Purpose: PR のコミットに対する CI 結果の追跡","lineNumber":185,"isSignature":false},{"text":"  - Actions: 失敗時は AI へのフィードバックと再試行、成功時はマージ条件再評価","lineNumber":186,"isSignature":false},{"text":"  - FR refs: FR-014, FR-015","lineNumber":187,"isSignature":false},{"text":"","lineNumber":188,"isSignature":false},{"text":"- push","lineNumber":189,"isSignature":false},{"text":"  - Purpose: 再試行コミット（追加コミット）の検知、PR head SHA 更新に伴う評価","lineNumber":190,"isSignature":false},{"text":"  - FR refs: FR-005, FR-014, FR-021","lineNumber":191,"isSignature":false},{"text":"","lineNumber":192,"isSignature":false},{"text":"- issues","lineNumber":193,"isSignature":false},{"text":"  - Purpose: 依存関係グラフの更新とブロック解除検知（closed/reopened）","lineNumber":194,"isSignature":false},{"text":"  - Actions: BlockerGraph の更新、ブロック解除時の AgentRun 起動","lineNumber":195,"isSignature":false},{"text":"  - FR refs: FR-007, FR-013","lineNumber":196,"isSignature":false},{"text":"","lineNumber":197,"isSignature":false},{"text":"- workflow_run（必要に応じて）","lineNumber":198,"isSignature":false},{"text":"  - Purpose: 再利用ワークフロー等で check_* が発火しない CI の代替フック","lineNumber":199,"isSignature":false},{"text":"  - Actions: 上記 CI 追跡と同等に扱う（check_* が利用できない場合のみ）","lineNumber":200,"isSignature":false},{"text":"  - FR refs: FR-014","lineNumber":201,"isSignature":false},{"text":"","lineNumber":202,"isSignature":false},{"text":"### Key Entities (include if feature involves data)","lineNumber":203,"isSignature":false},{"text":"","lineNumber":204,"isSignature":false},{"text":"- Issue: ID, タイトル, 本文, ラベル, コメント","lineNumber":205,"isSignature":false},{"text":"- PullRequest: ID, ブランチ, ステータス, レビュー, マージ状態","lineNumber":206,"isSignature":false},{"text":"- AgentRun: 状態(queued/started/succeeded/failed), 入力, 出力, リンク(PR/コミット), リトライ回数(最大50), github_event_id(X-GitHub-Delivery)","lineNumber":207,"isSignature":false},{"text":"- ReviewFeedback: 出所(Codex), 内容, ステータス, タイムスタンプ","lineNumber":208,"isSignature":false},{"text":"- BlockerGraph: タスクと依存関係の有向グラフ","lineNumber":209,"isSignature":false},{"text":"","lineNumber":210,"isSignature":false},{"text":"#### Glossary","lineNumber":211,"isSignature":false},{"text":"","lineNumber":212,"isSignature":false},{"text":"- **AI**: Issueをもとにコーディングを行うAIエージェントとして本仕様全体で統一する。","lineNumber":213,"isSignature":false},{"text":"","lineNumber":214,"isSignature":false},{"text":"#### MySQL Constraints (sketch)","lineNumber":215,"isSignature":false},{"text":"","lineNumber":216,"isSignature":false},{"text":"- AgentRun: PK(id), UK(idempotency_key=X-GitHub-Delivery), state ENUM(queued,started,succeeded,failed), pr_id(FK: PullRequest.id, NULL 可), created_at, updated_at","lineNumber":217,"isSignature":false},{"text":"- ReviewFeedback: PK(id), pr_id(FK: PullRequest.id), source ENUM(Codex), created_at, updated_at","lineNumber":218,"isSignature":false},{"text":"- PullRequest: PK(id), repo, number, branch, status, mergeable, created_at, updated_at","lineNumber":219,"isSignature":false}]},"score":0.2579193115234375},{"codeBlock":{"relativeWorkspacePath":"specs/001-github-agent-automation/spec.md","range":{"startPosition":{"line":217,"column":0},"endPosition":{"line":252,"column":0}},"contents":"- ReviewFeedback: PK(id), pr_id(FK: PullRequest.id), source ENUM(Codex), created_at, updated_at\n- PullRequest: PK(id), repo, number, branch, status, mergeable, created_at, updated_at\n- Issue: PK(id), repo, number, title, created_at, updated_at\n- BlockerGraphEdges: PK(task_id, depends_on_task_id), FK(task_id -> Issue.id, depends_on_task_id -> Issue.id)\n\n- Indexes:\n- AgentRun: INDEX(idempotency_key)\n- PullRequest: INDEX(repo, number)\n- BlockerGraphEdges: INDEX(task_id, depends_on_task_id)\n\n- OperationLog: PK(id), run_id(FK: AgentRun.id), operation_type ENUM(pr-create, post-comment, request-review, merge), operation_id(UK), status, created_at\n\n## Success Criteria (mandatory)\n\n### Measurable Outcomes\n\n- SC-001: トリガコメントからエージェント実行が迅速に開始される\n- SC-002: 成功フローで最初の PR が自動作成される\n- SC-003: レビュー応答受領から再試行コミットが自動作成される\n- SC-004: 重複イベントで重複 PR/実行が発生しない（0 件）\n- SC-005: 依存タスクのブロック解消から次タスクが自動開始される\n- SC-006: CI 失敗検知から AI 再試行が自動的に開始される\n- SC-007: 「Codex Review: Didn't find any major issues.」コメント検知からマージ再試行が行われる\n- SC-008: 50回再試行してもCI成功／Approve出ずに失敗となった場合、GitHub IssueおよびDiscord Webhookに通知される\n- SC-009: DoD条件はCI成功・ノーコンフリクト・Codex approveの全てを満たすこと\n  かつ PR が実際にマージ完了（status=merged）であること\n\n- SC-010: 同一ブランチで同時実行が 2 件以上発生しない（0 件）\n- SC-011: 承認検知は Bot 検証または Reviews API により誤検知 0 件\n\n## Observability\n\n- 追跡ID: `github_event_id`（X-GitHub-Delivery）+ `agent_run_id` + `operation_id` を全ログ/メトリクス/トレースに付与する\n- 最小メトリクス: 実行時間、再試行回数、失敗理由、外部 API 呼数、キュー滞留時間\n- 出力先: 運用環境のログ/メトリクス基盤（例: OpenTelemetry）に送出する","signatures":{"ranges":[]},"detailedLines":[{"text":"- ReviewFeedback: PK(id), pr_id(FK: PullRequest.id), source ENUM(Codex), created_at, updated_at","lineNumber":218,"isSignature":false},{"text":"- PullRequest: PK(id), repo, number, branch, status, mergeable, created_at, updated_at","lineNumber":219,"isSignature":false},{"text":"- Issue: PK(id), repo, number, title, created_at, updated_at","lineNumber":220,"isSignature":false},{"text":"- BlockerGraphEdges: PK(task_id, depends_on_task_id), FK(task_id -> Issue.id, depends_on_task_id -> Issue.id)","lineNumber":221,"isSignature":false},{"text":"","lineNumber":222,"isSignature":false},{"text":"- Indexes:","lineNumber":223,"isSignature":false},{"text":"- AgentRun: INDEX(idempotency_key)","lineNumber":224,"isSignature":false},{"text":"- PullRequest: INDEX(repo, number)","lineNumber":225,"isSignature":false},{"text":"- BlockerGraphEdges: INDEX(task_id, depends_on_task_id)","lineNumber":226,"isSignature":false},{"text":"","lineNumber":227,"isSignature":false},{"text":"- OperationLog: PK(id), run_id(FK: AgentRun.id), operation_type ENUM(pr-create, post-comment, request-review, merge), operation_id(UK), status, created_at","lineNumber":228,"isSignature":false},{"text":"","lineNumber":229,"isSignature":false},{"text":"## Success Criteria (mandatory)","lineNumber":230,"isSignature":false},{"text":"","lineNumber":231,"isSignature":false},{"text":"### Measurable Outcomes","lineNumber":232,"isSignature":false},{"text":"","lineNumber":233,"isSignature":false},{"text":"- SC-001: トリガコメントからエージェント実行が迅速に開始される","lineNumber":234,"isSignature":false},{"text":"- SC-002: 成功フローで最初の PR が自動作成される","lineNumber":235,"isSignature":false},{"text":"- SC-003: レビュー応答受領から再試行コミットが自動作成される","lineNumber":236,"isSignature":false},{"text":"- SC-004: 重複イベントで重複 PR/実行が発生しない（0 件）","lineNumber":237,"isSignature":false},{"text":"- SC-005: 依存タスクのブロック解消から次タスクが自動開始される","lineNumber":238,"isSignature":false},{"text":"- SC-006: CI 失敗検知から AI 再試行が自動的に開始される","lineNumber":239,"isSignature":false},{"text":"- SC-007: 「Codex Review: Didn't find any major issues.」コメント検知からマージ再試行が行われる","lineNumber":240,"isSignature":false},{"text":"- SC-008: 50回再試行してもCI成功／Approve出ずに失敗となった場合、GitHub IssueおよびDiscord Webhookに通知される","lineNumber":241,"isSignature":false},{"text":"- SC-009: DoD条件はCI成功・ノーコンフリクト・Codex approveの全てを満たすこと","lineNumber":242,"isSignature":false},{"text":"  かつ PR が実際にマージ完了（status=merged）であること","lineNumber":243,"isSignature":false},{"text":"","lineNumber":244,"isSignature":false},{"text":"- SC-010: 同一ブランチで同時実行が 2 件以上発生しない（0 件）","lineNumber":245,"isSignature":false},{"text":"- SC-011: 承認検知は Bot 検証または Reviews API により誤検知 0 件","lineNumber":246,"isSignature":false},{"text":"","lineNumber":247,"isSignature":false},{"text":"## Observability","lineNumber":248,"isSignature":false},{"text":"","lineNumber":249,"isSignature":false},{"text":"- 追跡ID: `github_event_id`（X-GitHub-Delivery）+ `agent_run_id` + `operation_id` を全ログ/メトリクス/トレースに付与する","lineNumber":250,"isSignature":false},{"text":"- 最小メトリクス: 実行時間、再試行回数、失敗理由、外部 API 呼数、キュー滞留時間","lineNumber":251,"isSignature":false},{"text":"- 出力先: 運用環境のログ/メトリクス基盤（例: OpenTelemetry）に送出する","lineNumber":252,"isSignature":false}]},"score":0.25286218523979187},{"codeBlock":{"relativeWorkspacePath":"specs/001-github-agent-automation/data-model.md","range":{"startPosition":{"line":174,"column":0},"endPosition":{"line":228,"column":0}},"contents":"- Blocked task Y becomes unblocked when ALL its dependencies are closed\n- Cycle detection via DFS before starting execution\n\n**Parsing**: Extract from Issue body/comments using regex:\n- \"blocked by #123\" or \"depends on #456\"\n- \"blocking #789\" (inverse relationship)\n\n### AuditLog\n\n**NEW ENTITY** - Immutable audit trail for all system operations\n\n- id: INT (PK, auto-increment)\n- event_type: STRING (e.g., \"webhook.received\", \"agent.started\", \"pr.created\", \"review.received\", \"ci.failed\")\n- actor: STRING (GitHub username or \"system\")\n- resource_type: STRING (e.g., \"Issue\", \"PullRequest\", \"AgentRun\")\n- resource_id: INT (ID of the affected resource)\n- payload: JSON (full event payload for debugging)\n- idempotency_key: STRING (nullable) - **X-GitHub-Delivery if from webhook**\n- ip_address: STRING (nullable) - **for webhook source tracking**\n- user_agent: STRING (nullable) - **webhook User-Agent header**\n- created_at: DATETIME (immutable, never updated)\n\n**Relationships**:\n- None (standalone audit log, referenced by resource_type + resource_id)\n\n**Indexes**:\n- INDEX(event_type, created_at DESC) - for filtering by event type\n- INDEX(resource_type, resource_id) - for querying history by resource\n- INDEX(actor) - for user activity tracking\n- INDEX(idempotency_key) - for webhook deduplication audit\n\n**Business Rules**:\n- Records are NEVER updated or deleted (append-only log)\n- Retention policy: keep for 90 days minimum (configurable)\n- Critical events to log:\n  - All webhook receptions\n  - Agent execution start/stop\n  - PR creation/merge\n  - Review requests/results\n  - CI status changes\n  - Failures and errors\n  - Retry attempts\n\n### OperationLog\n\nImmutable per-operation log to enforce operation-level idempotency and trace actions tied to an AgentRun.\n\n- id: INT (PK, auto-increment)\n- run_id: INT (FK to AgentRun.id)\n- operation_type: ENUM(pr-create, post-comment, request-review, merge)\n- operation_id: STRING (UK) - client-supplied idempotency key per operation\n- status: ENUM(pending, succeeded, failed)\n- created_at: DATETIME","signatures":{"ranges":[]},"detailedLines":[{"text":"- Blocked task Y becomes unblocked when ALL its dependencies are closed","lineNumber":175,"isSignature":false},{"text":"- Cycle detection via DFS before starting execution","lineNumber":176,"isSignature":false},{"text":"","lineNumber":177,"isSignature":false},{"text":"**Parsing**: Extract from Issue body/comments using regex:","lineNumber":178,"isSignature":false},{"text":"- \"blocked by #123\" or \"depends on #456\"","lineNumber":179,"isSignature":false},{"text":"- \"blocking #789\" (inverse relationship)","lineNumber":180,"isSignature":false},{"text":"","lineNumber":181,"isSignature":false},{"text":"### AuditLog","lineNumber":182,"isSignature":false},{"text":"","lineNumber":183,"isSignature":false},{"text":"**NEW ENTITY** - Immutable audit trail for all system operations","lineNumber":184,"isSignature":false},{"text":"","lineNumber":185,"isSignature":false},{"text":"- id: INT (PK, auto-increment)","lineNumber":186,"isSignature":false},{"text":"- event_type: STRING (e.g., \"webhook.received\", \"agent.started\", \"pr.created\", \"review.received\", \"ci.failed\")","lineNumber":187,"isSignature":false},{"text":"- actor: STRING (GitHub username or \"system\")","lineNumber":188,"isSignature":false},{"text":"- resource_type: STRING (e.g., \"Issue\", \"PullRequest\", \"AgentRun\")","lineNumber":189,"isSignature":false},{"text":"- resource_id: INT (ID of the affected resource)","lineNumber":190,"isSignature":false},{"text":"- payload: JSON (full event payload for debugging)","lineNumber":191,"isSignature":false},{"text":"- idempotency_key: STRING (nullable) - **X-GitHub-Delivery if from webhook**","lineNumber":192,"isSignature":false},{"text":"- ip_address: STRING (nullable) - **for webhook source tracking**","lineNumber":193,"isSignature":false},{"text":"- user_agent: STRING (nullable) - **webhook User-Agent header**","lineNumber":194,"isSignature":false},{"text":"- created_at: DATETIME (immutable, never updated)","lineNumber":195,"isSignature":false},{"text":"","lineNumber":196,"isSignature":false},{"text":"**Relationships**:","lineNumber":197,"isSignature":false},{"text":"- None (standalone audit log, referenced by resource_type + resource_id)","lineNumber":198,"isSignature":false},{"text":"","lineNumber":199,"isSignature":false},{"text":"**Indexes**:","lineNumber":200,"isSignature":false},{"text":"- INDEX(event_type, created_at DESC) - for filtering by event type","lineNumber":201,"isSignature":false},{"text":"- INDEX(resource_type, resource_id) - for querying history by resource","lineNumber":202,"isSignature":false},{"text":"- INDEX(actor) - for user activity tracking","lineNumber":203,"isSignature":false},{"text":"- INDEX(idempotency_key) - for webhook deduplication audit","lineNumber":204,"isSignature":false},{"text":"","lineNumber":205,"isSignature":false},{"text":"**Business Rules**:","lineNumber":206,"isSignature":false},{"text":"- Records are NEVER updated or deleted (append-only log)","lineNumber":207,"isSignature":false},{"text":"- Retention policy: keep for 90 days minimum (configurable)","lineNumber":208,"isSignature":false},{"text":"- Critical events to log:","lineNumber":209,"isSignature":false},{"text":"  - All webhook receptions","lineNumber":210,"isSignature":false},{"text":"  - Agent execution start/stop","lineNumber":211,"isSignature":false},{"text":"  - PR creation/merge","lineNumber":212,"isSignature":false},{"text":"  - Review requests/results","lineNumber":213,"isSignature":false},{"text":"  - CI status changes","lineNumber":214,"isSignature":false},{"text":"  - Failures and errors","lineNumber":215,"isSignature":false},{"text":"  - Retry attempts","lineNumber":216,"isSignature":false},{"text":"","lineNumber":217,"isSignature":false},{"text":"### OperationLog","lineNumber":218,"isSignature":false},{"text":"","lineNumber":219,"isSignature":false},{"text":"Immutable per-operation log to enforce operation-level idempotency and trace actions tied to an AgentRun.","lineNumber":220,"isSignature":false},{"text":"","lineNumber":221,"isSignature":false},{"text":"- id: INT (PK, auto-increment)","lineNumber":222,"isSignature":false},{"text":"- run_id: INT (FK to AgentRun.id)","lineNumber":223,"isSignature":false},{"text":"- operation_type: ENUM(pr-create, post-comment, request-review, merge)","lineNumber":224,"isSignature":false},{"text":"- operation_id: STRING (UK) - client-supplied idempotency key per operation","lineNumber":225,"isSignature":false},{"text":"- status: ENUM(pending, succeeded, failed)","lineNumber":226,"isSignature":false},{"text":"- created_at: DATETIME","lineNumber":227,"isSignature":false}]},"score":0.250331312417984},{"codeBlock":{"relativeWorkspacePath":"specs/001-github-agent-automation/spec.md","range":{"startPosition":{"line":59,"column":0},"endPosition":{"line":107,"column":0}},"contents":"1. Given 実行が started When 変更生成が成功 Then 新規ブランチとコミットが作成される\n2. Given コミットが作成済み When プッシュが成功 Then 新規 PR が作成されリンクが保存される\n\nNote (Scope Boundary): US2では失敗時の「記録・要約抽出」までを対象とし、自動再試行（retry_count増分とK8s Job再作成）はUS3で扱う。\n\n---\n\n### User Story 3 - Codex レビューと再試行 (Priority: P2)\n\n作成した PR を Codex にレビュー依頼し、戻り結果を AI にフィードバックして修正を再試\n行する。\n\n**Why this priority**: 品質向上と自動改善ループの実現。\n\n**Independent Test**: ダミーのレビュー応答を与えた場合、再実行が行われ新しいコミットが\n積み上がること。\n\n**Acceptance Scenarios**:\n1. Given PR が作成済み When システムがレビュー依頼を実行 Then PR に `@codex review` コメントが投稿され Codex サービスへのレビュー依頼が送信・記録される\n2. Given レビュー結果がある When AI に再入力 Then 追加コミットが作成される\n\n---\n\n### User Story 4 - Approve と自動マージ (Priority: P2)\n\nPR が承認状態になったら自動でマージする。\n\n**Why this priority**: フロー完結のために必要。\n\n**Independent Test**: PR に Approve を付与すると自動でマージされること。\n\n**Acceptance Scenarios**:\n1. Given PR が Approve 済み When マージ条件を満たす Then マージが成功する\n2. Given マージ要件を満たさない When 処理実行 Then マージは行われず状態が記録される\n\n---\n\n### User Story 5 - ブロック解除によるタスク再開 (Priority: P3)\n\n依存関係を持つタスクがブロックされている場合、完了によりブロックが解消されたタスクに\n自動着手する。\n\n**Why this priority**: 継続的な自動推進。\n\n**Independent Test**: 依存関係グラフでブロック解消時に次タスク実行が開始されること。\n\n**Acceptance Scenarios**:\n1. Given タスクB がタスクA に依存 When タスクA が完了 Then タスクB の実行が開始される","signatures":{"ranges":[]},"detailedLines":[{"text":"1. Given 実行が started When 変更生成が成功 Then 新規ブランチとコミットが作成される","lineNumber":60,"isSignature":false},{"text":"2. Given コミットが作成済み When プッシュが成功 Then 新規 PR が作成されリンクが保存される","lineNumber":61,"isSignature":false},{"text":"","lineNumber":62,"isSignature":false},{"text":"Note (Scope Boundary): US2では失敗時の「記録・要約抽出」までを対象とし、自動再試行（retry_count増分とK8s Job再作成）はUS3で扱う。","lineNumber":63,"isSignature":false},{"text":"","lineNumber":64,"isSignature":false},{"text":"---","lineNumber":65,"isSignature":false},{"text":"","lineNumber":66,"isSignature":false},{"text":"### User Story 3 - Codex レビューと再試行 (Priority: P2)","lineNumber":67,"isSignature":false},{"text":"","lineNumber":68,"isSignature":false},{"text":"作成した PR を Codex にレビュー依頼し、戻り結果を AI にフィードバックして修正を再試","lineNumber":69,"isSignature":false},{"text":"行する。","lineNumber":70,"isSignature":false},{"text":"","lineNumber":71,"isSignature":false},{"text":"**Why this priority**: 品質向上と自動改善ループの実現。","lineNumber":72,"isSignature":false},{"text":"","lineNumber":73,"isSignature":false},{"text":"**Independent Test**: ダミーのレビュー応答を与えた場合、再実行が行われ新しいコミットが","lineNumber":74,"isSignature":false},{"text":"積み上がること。","lineNumber":75,"isSignature":false},{"text":"","lineNumber":76,"isSignature":false},{"text":"**Acceptance Scenarios**:","lineNumber":77,"isSignature":false},{"text":"1. Given PR が作成済み When システムがレビュー依頼を実行 Then PR に `@codex review` コメントが投稿され Codex サービスへのレビュー依頼が送信・記録される","lineNumber":78,"isSignature":false},{"text":"2. Given レビュー結果がある When AI に再入力 Then 追加コミットが作成される","lineNumber":79,"isSignature":false},{"text":"","lineNumber":80,"isSignature":false},{"text":"---","lineNumber":81,"isSignature":false},{"text":"","lineNumber":82,"isSignature":false},{"text":"### User Story 4 - Approve と自動マージ (Priority: P2)","lineNumber":83,"isSignature":false},{"text":"","lineNumber":84,"isSignature":false},{"text":"PR が承認状態になったら自動でマージする。","lineNumber":85,"isSignature":false},{"text":"","lineNumber":86,"isSignature":false},{"text":"**Why this priority**: フロー完結のために必要。","lineNumber":87,"isSignature":false},{"text":"","lineNumber":88,"isSignature":false},{"text":"**Independent Test**: PR に Approve を付与すると自動でマージされること。","lineNumber":89,"isSignature":false},{"text":"","lineNumber":90,"isSignature":false},{"text":"**Acceptance Scenarios**:","lineNumber":91,"isSignature":false},{"text":"1. Given PR が Approve 済み When マージ条件を満たす Then マージが成功する","lineNumber":92,"isSignature":false},{"text":"2. Given マージ要件を満たさない When 処理実行 Then マージは行われず状態が記録される","lineNumber":93,"isSignature":false},{"text":"","lineNumber":94,"isSignature":false},{"text":"---","lineNumber":95,"isSignature":false},{"text":"","lineNumber":96,"isSignature":false},{"text":"### User Story 5 - ブロック解除によるタスク再開 (Priority: P3)","lineNumber":97,"isSignature":false},{"text":"","lineNumber":98,"isSignature":false},{"text":"依存関係を持つタスクがブロックされている場合、完了によりブロックが解消されたタスクに","lineNumber":99,"isSignature":false},{"text":"自動着手する。","lineNumber":100,"isSignature":false},{"text":"","lineNumber":101,"isSignature":false},{"text":"**Why this priority**: 継続的な自動推進。","lineNumber":102,"isSignature":false},{"text":"","lineNumber":103,"isSignature":false},{"text":"**Independent Test**: 依存関係グラフでブロック解消時に次タスク実行が開始されること。","lineNumber":104,"isSignature":false},{"text":"","lineNumber":105,"isSignature":false},{"text":"**Acceptance Scenarios**:","lineNumber":106,"isSignature":false},{"text":"1. Given タスクB がタスクA に依存 When タスクA が完了 Then タスクB の実行が開始される","lineNumber":107,"isSignature":false}]},"score":0.2430173009634018},{"codeBlock":{"relativeWorkspacePath":"specs/001-github-agent-automation/data-model.md","range":{"startPosition":{"line":0,"column":0},"endPosition":{"line":59,"column":0}},"contents":"# data-model.md: GitHub Agent Automation データモデル\n\n**Last Updated**: 2025-10-31\n**Database**: MySQL 8.0+ with GORM (Go)\n**Schema Location**: GORM models in `internal/models`, SQL migrations in `migrations/` (goose)\n\n## エンティティ定義・属性\n\n### Issue\n- id: INT (PK, auto-increment)\n- repo: STRING (e.g., \"owner/repo-name\")\n- number: INT (GitHub Issue number)\n- github_issue_id: BIGINT UNSIGNED (numeric GitHub Issue ID)\n- title: STRING\n- body: TEXT (nullable)\n- labels: JSON (array of label names)\n- state: ENUM(open/closed)\n- created_at: DATETIME\n- updated_at: DATETIME\n\n**Relationships**:\n- has many AgentRun (one Issue can trigger multiple runs)\n- has many BlockerGraphEdges (as task or dependent task)\n\n**Indexes**:\n- UNIQUE(repo, number) - prevent duplicate Issue records\n\n### PullRequest\n- id: INT (PK, auto-increment)\n- repo: STRING\n- number: INT (GitHub PR number)\n- issue_id: INT (FK to Issue.id, nullable) - **NEW**: tracks which Issue triggered this PR\n- branch: STRING (e.g., \"feature/issue-123\")\n- base_branch: STRING (e.g., \"main\", default: \"main\")\n- status: ENUM(open/closed/merged)\n- mergeable: BOOL (nullable) - **NEW**: GitHub mergeable status\n- created_at: DATETIME\n- updated_at: DATETIME\n\n**Relationships**:\n- has many ReviewFeedback\n- has many CIStatus\n- belongs to Issue (optional, via issue_id)\n- has many AgentRun (one PR can have multiple retry attempts)\n\n**Indexes**:\n- UNIQUE(repo, number)\n- INDEX(issue_id) - for querying PRs by Issue\n\n### AgentRun\n- id: INT (PK, auto-increment)\n- idempotency_key: STRING (UK) - **X-GitHub-Delivery header for deduplication**\n- issue_id: INT (FK to Issue.id) - **NEW**: which Issue is being processed\n- pr_id: INT (FK to PullRequest.id, nullable) - PR created by this run\n- state: ENUM(queued/started/succeeded/failed)\n- agent_type: ENUM(claude-code/cursor-agent) - **NEW**: Which AI agent was used\n- input: JSON (Issue context, comments, dependencies, **manifest config**)\n- output: JSON (AI agent response, changes made)\n- retry_count: INT (default: 0, max: 50)","signatures":{"ranges":[]},"detailedLines":[{"text":"# data-model.md: GitHub Agent Automation データモデル","lineNumber":1,"isSignature":false},{"text":"","lineNumber":2,"isSignature":false},{"text":"**Last Updated**: 2025-10-31","lineNumber":3,"isSignature":false},{"text":"**Database**: MySQL 8.0+ with GORM (Go)","lineNumber":4,"isSignature":false},{"text":"**Schema Location**: GORM models in `internal/models`, SQL migrations in `migrations/` (goose)","lineNumber":5,"isSignature":false},{"text":"","lineNumber":6,"isSignature":false},{"text":"## エンティティ定義・属性","lineNumber":7,"isSignature":false},{"text":"","lineNumber":8,"isSignature":false},{"text":"### Issue","lineNumber":9,"isSignature":false},{"text":"- id: INT (PK, auto-increment)","lineNumber":10,"isSignature":false},{"text":"- repo: STRING (e.g., \"owner/repo-name\")","lineNumber":11,"isSignature":false},{"text":"- number: INT (GitHub Issue number)","lineNumber":12,"isSignature":false},{"text":"- github_issue_id: BIGINT UNSIGNED (numeric GitHub Issue ID)","lineNumber":13,"isSignature":false},{"text":"- title: STRING","lineNumber":14,"isSignature":false},{"text":"- body: TEXT (nullable)","lineNumber":15,"isSignature":false},{"text":"- labels: JSON (array of label names)","lineNumber":16,"isSignature":false},{"text":"- state: ENUM(open/closed)","lineNumber":17,"isSignature":false},{"text":"- created_at: DATETIME","lineNumber":18,"isSignature":false},{"text":"- updated_at: DATETIME","lineNumber":19,"isSignature":false},{"text":"","lineNumber":20,"isSignature":false},{"text":"**Relationships**:","lineNumber":21,"isSignature":false},{"text":"- has many AgentRun (one Issue can trigger multiple runs)","lineNumber":22,"isSignature":false},{"text":"- has many BlockerGraphEdges (as task or dependent task)","lineNumber":23,"isSignature":false},{"text":"","lineNumber"