neNumber":163,"isSignature":false},{"text":"","lineNumber":164,"isSignature":false},{"text":"**Relationships**:","lineNumber":165,"isSignature":false},{"text":"- task_id references Issue (the blocked task)","lineNumber":166,"isSignature":false},{"text":"- depends_on_task_id references Issue (the blocking task)","lineNumber":167,"isSignature":false},{"text":"","lineNumber":168,"isSignature":false},{"text":"**Indexes**:","lineNumber":169,"isSignature":false},{"text":"- PRIMARY KEY(task_id, depends_on_task_id)","lineNumber":170,"isSignature":false},{"text":"- INDEX(depends_on_task_id) - for finding all tasks blocked by a specific Issue","lineNumber":171,"isSignature":false},{"text":"","lineNumber":172,"isSignature":false},{"text":"**Business Rules**:","lineNumber":173,"isSignature":false},{"text":"- When Issue X closes, query `depends_on_task_id = X` to find blocked tasks","lineNumber":174,"isSignature":false},{"text":"- Blocked task Y becomes unblocked when ALL its dependencies are closed","lineNumber":175,"isSignature":false},{"text":"- Cycle detection via DFS before starting execution","lineNumber":176,"isSignature":false}]},"score":0.32930660247802734},{"codeBlock":{"relativeWorkspacePath":"internal/repositories/blocker_graph.go","range":{"startPosition":{"line":130,"column":1},"endPosition":{"line":162,"column":1}},"contents":"// GetAllEdges returns all edges in the blocker graph\n// Used for cycle detection and full graph traversal\n// Returns empty slice (not nil) if no edges found\nfunc (r *BlockerGraphRepository) GetAllEdges() ([]models.BlockerGraphEdge, error) {\n\tvar edges []models.BlockerGraphEdge\n\n\tresult := r.db.Find(&edges)\n\tif result.Error != nil {\n\t\treturn nil, result.Error\n\t}\n\n\t// Return empty slice instead of nil\n\tif edges == nil {\n\t\tedges = []models.BlockerGraphEdge{}\n\t}\n\n\treturn edges, nil\n}\n\n// DeleteEdgesByTaskID deletes all edges where the task is involved as either task_id or depends_on_task_id\n// Used for cleanup when an issue is deleted or dependencies need to be cleared\nfunc (r *BlockerGraphRepository) DeleteEdgesByTaskID(taskID int) error {\n\tresult := r.db.Where(\"task_id = ? OR depends_on_task_id = ?\", taskID, taskID).\n\t\tDelete(&models.BlockerGraphEdge{})\n\n\tif result.Error != nil {\n\t\treturn result.Error\n\t}\n\n\treturn nil\n}","signatures":{"ranges":[]},"detailedLines":[{"text":"// GetAllEdges returns all edges in the blocker graph","lineNumber":133,"isSignature":false},{"text":"// Used for cycle detection and full graph traversal","lineNumber":134,"isSignature":false},{"text":"// Returns empty slice (not nil) if no edges found","lineNumber":135,"isSignature":false},{"text":"func (r *BlockerGraphRepository) GetAllEdges() ([]models.BlockerGraphEdge, error) {","lineNumber":136,"isSignature":false},{"text":"\tvar edges []models.BlockerGraphEdge","lineNumber":137,"isSignature":false},{"text":"","lineNumber":138,"isSignature":false},{"text":"\tresult := r.db.Find(&edges)","lineNumber":139,"isSignature":false},{"text":"\tif result.Error != nil {","lineNumber":140,"isSignature":false},{"text":"\t\treturn nil, result.Error","lineNumber":141,"isSignature":false},{"text":"\t}","lineNumber":142,"isSignature":false},{"text":"","lineNumber":143,"isSignature":false},{"text":"\t// Return empty slice instead of nil","lineNumber":144,"isSignature":false},{"text":"\tif edges == nil {","lineNumber":145,"isSignature":false},{"text":"\t\tedges = []models.BlockerGraphEdge{}","lineNumber":146,"isSignature":false},{"text":"\t}","lineNumber":147,"isSignature":false},{"text":"","lineNumber":148,"isSignature":false},{"text":"\treturn edges, nil","lineNumber":149,"isSignature":false},{"text":"}","lineNumber":150,"isSignature":false},{"text":"","lineNumber":151,"isSignature":false},{"text":"// DeleteEdgesByTaskID deletes all edges where the task is involved as either task_id or depends_on_task_id","lineNumber":152,"isSignature":false},{"text":"// Used for cleanup when an issue is deleted or dependencies need to be cleared","lineNumber":153,"isSignature":false},{"text":"func (r *BlockerGraphRepository) DeleteEdgesByTaskID(taskID int) error {","lineNumber":154,"isSignature":false},{"text":"\tresult := r.db.Where(\"task_id = ? OR depends_on_task_id = ?\", taskID, taskID).","lineNumber":155,"isSignature":false},{"text":"\t\tDelete(&models.BlockerGraphEdge{})","lineNumber":156,"isSignature":false},{"text":"","lineNumber":157,"isSignature":false},{"text":"\tif result.Error != nil {","lineNumber":158,"isSignature":false},{"text":"\t\treturn result.Error","lineNumber":159,"isSignature":false},{"text":"\t}","lineNumber":160,"isSignature":false},{"text":"","lineNumber":161,"isSignature":false},{"text":"\treturn nil","lineNumber":162,"isSignature":false},{"text":"}","lineNumber":163,"isSignature":false}]},"score":0.3238723874092102},{"codeBlock":{"relativeWorkspacePath":"specs/001-github-agent-automation/contracts/github-webhooks.md","range":{"startPosition":{"line":83,"column":0},"endPosition":{"line":188,"column":0}},"contents":"**Purpose**: Detect dependency graph changes and trigger unblocked tasks\n\n**Actions Subscribed**: `closed`, `reopened`\n\n**Webhook Payload**:\n\n```json\n{\n  \"action\": \"closed\",\n  \"issue\": {\n    \"id\": 123456,\n    \"number\": 42,\n    \"title\": \"Task A\",\n    \"body\": \"This blocks #43 and #44\",\n    \"state\": \"closed\"\n  },\n  \"repository\": {\n    \"full_name\": \"octocat/hello-world\"\n  }\n}\n```\n\n**Processing**:\n\n1. Parse Issue body/comments for dependency keywords:\n   - \"blocked by #N\"\n   - \"depends on #N\"\n   - \"blocking #N\"\n2. Update BlockerGraphEdges table\n3. On `action: closed`:\n   - Query BlockerGraphEdges for dependents\n   - Check if all dependencies resolved\n   - Trigger new AgentRun for unblocked Issues\n4. Log dependency changes to AuditLog\n\n**Dependency Parsing Regex**:\n\n```regex\nblocked by #(\\d+)\ndepends on #(\\d+)\nblocking #(\\d+)\n```\n\n---\n\n### 3. pull_request\n\nTriggered when a PR is opened, closed, or synchronized (new commits pushed).\n\n**Purpose**: Track PR status and detect merge events\n\n**Actions Subscribed**: `opened`, `synchronize`, `closed`\n\n**Webhook Payload**:\n\n```json\n{\n  \"action\": \"opened\",\n  \"number\": 101,\n  \"pull_request\": {\n    \"id\": 987654,\n    \"number\": 101,\n    \"title\": \"Fix bug in parser\",\n    \"head\": {\n      \"ref\": \"feature/issue-42\"\n    },\n    \"base\": {\n      \"ref\": \"main\"\n    },\n    \"state\": \"open\",\n    \"mergeable\": true,\n    \"merged\": false,\n    \"user\": {\n      \"login\": \"github-agent-bot\"\n    }\n  },\n  \"repository\": {\n    \"full_name\": \"octocat/hello-world\"\n  }\n}\n```\n\n**Processing**:\n\n1. Upsert PullRequest record\n2. Link to AgentRun (if created by agent)\n3. On `action: synchronize` (new commits):\n   - Reset CI status (CIStatus records)\n   - Wait for check_suite webhook\n4. On `action: closed` with `merged: true`:\n   - Update AgentRun state to succeeded\n   - Log merge event\n5. Check merge conditions (MergeConditionChecker)\n\n---\n\n### 4. pull_request_review (FR-010, FR-015)\n\nTriggered when a review is submitted on a PR.\n\n**Purpose**: Detect Codex approval for auto-merge\n\n**Webhook Payload**:","signatures":{"ranges":[]},"detailedLines":[{"text":"**Purpose**: Detect dependency graph changes and trigger unblocked tasks","lineNumber":85,"isSignature":false},{"text":"","lineNumber":86,"isSignature":false},{"text":"**Actions Subscribed**: `closed`, `reopened`","lineNumber":87,"isSignature":false},{"text":"","lineNumber":88,"isSignature":false},{"text":"**Webhook Payload**:","lineNumber":89,"isSignature":false},{"text":"","lineNumber":90,"isSignature":false},{"text":"```json","lineNumber":91,"isSignature":false},{"text":"{","lineNumber":92,"isSignature":false},{"text":"  \"action\": \"closed\",","lineNumber":93,"isSignature":false},{"text":"  \"issue\": {","lineNumber":94,"isSignature":false},{"text":"    \"id\": 123456,","lineNumber":95,"isSignature":false},{"text":"    \"number\": 42,","lineNumber":96,"isSignature":false},{"text":"    \"title\": \"Task A\",","lineNumber":97,"isSignature":false},{"text":"    \"body\": \"This blocks #43 and #44\",","lineNumber":98,"isSignature":false},{"text":"    \"state\": \"closed\"","lineNumber":99,"isSignature":false},{"text":"  },","lineNumber":100,"isSignature":false},{"text":"  \"repository\": {","lineNumber":101,"isSignature":false},{"text":"    \"full_name\": \"octocat/hello-world\"","lineNumber":102,"isSignature":false},{"text":"  }","lineNumber":103,"isSignature":false},{"text":"}","lineNumber":104,"isSignature":false},{"text":"```","lineNumber":105,"isSignature":false},{"text":"","lineNumber":106,"isSignature":false},{"text":"**Processing**:","lineNumber":107,"isSignature":false},{"text":"","lineNumber":108,"isSignature":false},{"text":"1. Parse Issue body/comments for dependency keywords:","lineNumber":109,"isSignature":false},{"text":"   - \"blocked by #N\"","lineNumber":110,"isSignature":false},{"text":"   - \"depends on #N\"","lineNumber":111,"isSignature":false},{"text":"   - \"blocking #N\"","lineNumber":112,"isSignature":false},{"text":"2. Update BlockerGraphEdges table","lineNumber":113,"isSignature":false},{"text":"3. On `action: closed`:","lineNumber":114,"isSignature":false},{"text":"   - Query BlockerGraphEdges for dependents","lineNumber":115,"isSignature":false},{"text":"   - Check if all dependencies resolved","lineNumber":116,"isSignature":false},{"text":"   - Trigger new AgentRun for unblocked Issues","lineNumber":117,"isSignature":false},{"text":"4. Log dependency changes to AuditLog","lineNumber":118,"isSignature":false},{"text":"","lineNumber":119,"isSignature":false},{"text":"**Dependency Parsing Regex**:","lineNumber":120,"isSignature":false},{"text":"","lineNumber":121,"isSignature":false},{"text":"```regex","lineNumber":122,"isSignature":false},{"text":"blocked by #(\\d+)","lineNumber":123,"isSignature":false},{"text":"depends on #(\\d+)","lineNumber":124,"isSignature":false},{"text":"blocking #(\\d+)","lineNumber":125,"isSignature":false},{"text":"```","lineNumber":126,"isSignature":false},{"text":"","lineNumber":127,"isSignature":false},{"text":"---","lineNumber":128,"isSignature":false},{"text":"","lineNumber":129,"isSignature":false},{"text":"### 3. pull_request","lineNumber":130,"isSignature":false},{"text":"","lineNumber":131,"isSignature":false},{"text":"Triggered when a PR is opened, closed, or synchronized (new commits pushed).","lineNumber":132,"isSignature":false},{"text":"","lineNumber":133,"isSignature":false},{"text":"**Purpose**: Track PR status and detect merge events","lineNumber":134,"isSignature":false},{"text":"","lineNumber":135,"isSignature":false},{"text":"**Actions Subscribed**: `opened`, `synchronize`, `closed`","lineNumber":136,"isSignature":false},{"text":"","lineNumber":137,"isSignature":false},{"text":"**Webhook Payload**:","lineNumber":138,"isSignature":false},{"text":"","lineNumber":139,"isSignature":false},{"text":"```json","lineNumber":140,"isSignature":false},{"text":"{","lineNumber":141,"isSignature":false},{"text":"  \"action\": \"opened\",","lineNumber":142,"isSignature":false},{"text":"  \"number\": 101,","lineNumber":143,"isSignature":false},{"text":"  \"pull_request\": {","lineNumber":144,"isSignature":false},{"text":"    \"id\": 987654,","lineNumber":145,"isSignature":false},{"text":"    \"number\": 101,","lineNumber":146,"isSignature":false},{"text":"    \"title\": \"Fix bug in parser\",","lineNumber":147,"isSignature":false},{"text":"    \"head\": {","lineNumber":148,"isSignature":false},{"text":"      \"ref\": \"feature/issue-42\"","lineNumber":149,"isSignature":false},{"text":"    },","lineNumber":150,"isSignature":false},{"text":"    \"base\": {","lineNumber":151,"isSignature":false},{"text":"      \"ref\": \"main\"","lineNumber":152,"isSignature":false},{"text":"    },","lineNumber":153,"isSignature":false},{"text":"    \"state\": \"open\",","lineNumber":154,"isSignature":false},{"text":"    \"mergeable\": true,","lineNumber":155,"isSignature":false},{"text":"    \"merged\": false,","lineNumber":156,"isSignature":false},{"text":"    \"user\": {","lineNumber":157,"isSignature":false},{"text":"      \"login\": \"github-agent-bot\"","lineNumber":158,"isSignature":false},{"text":"    }","lineNumber":159,"isSignature":false},{"text":"  },","lineNumber":160,"isSignature":false},{"text":"  \"repository\": {","lineNumber":161,"isSignature":false},{"text":"    \"full_name\": \"octocat/hello-world\"","lineNumber":162,"isSignature":false},{"text":"  }","lineNumber":163,"isSignature":false},{"text":"}","lineNumber":164,"isSignature":false},{"text":"```","lineNumber":165,"isSignature":false},{"text":"","lineNumber":166,"isSignature":false},{"text":"**Processing**:","lineNumber":167,"isSignature":false},{"text":"","lineNumber":168,"isSignature":false},{"text":"1. Upsert PullRequest record","lineNumber":169,"isSignature":false},{"text":"2. Link to AgentRun (if created by agent)","lineNumber":170,"isSignature":false},{"text":"3. On `action: synchronize` (new commits):","lineNumber":171,"isSignature":false},{"text":"   - Reset CI status (CIStatus records)","lineNumber":172,"isSignature":false},{"text":"   - Wait for check_suite webhook","lineNumber":173,"isSignature":false},{"text":"4. On `action: closed` with `merged: true`:","lineNumber":174,"isSignature":false},{"text":"   - Update AgentRun state to succeeded","lineNumber":175,"isSignature":false},{"text":"   - Log merge event","lineNumber":176,"isSignature":false},{"text":"5. Check merge conditions (MergeConditionChecker)","lineNumber":177,"isSignature":false},{"text":"","lineNumber":178,"isSignature":false},{"text":"---","lineNumber":179,"isSignature":false},{"text":"","lineNumber":180,"isSignature":false},{"text":"### 4. pull_request_review (FR-010, FR-015)","lineNumber":181,"isSignature":false},{"text":"","lineNumber":182,"isSignature":fa