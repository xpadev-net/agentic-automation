/ ShouldRetry checks if an AgentRun should be retried based on its retry count.","lineNumber":56,"isSignature":false},{"text":"// Returns true if retry_count < MaxRetryCount, false otherwise.","lineNumber":57,"isSignature":false},{"text":"//","lineNumber":58,"isSignature":false},{"text":"// Parameters:","lineNumber":59,"isSignature":false},{"text":"//   - agentRun: AgentRun instance to check (nil safe, returns false if nil)","lineNumber":60,"isSignature":false},{"text":"//","lineNumber":61,"isSignature":false},{"text":"// Returns:","lineNumber":62,"isSignature":false},{"text":"//   - bool: true if retry is allowed, false otherwise","lineNumber":63,"isSignature":false},{"text":"func (r *RetryOrchestrator) ShouldRetry(agentRun *models.AgentRun) bool {","lineNumber":64,"isSignature":false},{"text":"\tif agentRun == nil {","lineNumber":65,"isSignature":false},{"text":"\t\treturn false","lineNumber":66,"isSignature":false},{"text":"\t}","lineNumber":67,"isSignature":false}]},"score":0.41013649106025696},{"codeBlock":{"relativeWorkspacePath":"internal/services/retry_orchestrator.go","range":{"startPosition":{"line":62,"column":54},"endPosition":{"line":102,"column":19}},"contents":"func (r *RetryOrchestrator) ShouldRetry(agentRun *models.AgentRun) bool {\n\tif agentRun == nil {\n\t\treturn false\n\t}\n\n\tshouldRetry := agentRun.RetryCount < MaxRetryCount\n\n\tr.logger.Debug(\"Checking if retry is allowed\",\n\t\tzap.Int(\"agent_run_id\", agentRun.ID),\n\t\tzap.Int(\"retry_count\", agentRun.RetryCount),\n\t\tzap.Int(\"max_retry_count\", MaxRetryCount),\n\t\tzap.Bool(\"should_retry\", shouldRetry),\n\t\tzap.String(\"service\", \"retry_orchestrator\"),\n\t)\n\n\treturn shouldRetry\n}\n\n// IncrementRetryCount increments the retry count for an AgentRun and saves it to the database.\n// This method does NOT perform state transitions - it only updates the retry_count field.\n//\n// The method enforces the maximum retry limit (MaxRetryCount = 50). If the retry count\n// has already reached or exceeded the maximum, this method returns an error and does\n// not increment the count. This prevents retry_count from exceeding the configured maximum.\n//\n// This method uses an atomic UPDATE query at the repository level to prevent lost increments\n// under concurrent retries. The atomic operation ensures that even if multiple calls happen\n// simultaneously, each increment will be applied correctly without race conditions.\n// The caller's agentRun parameter is updated with the latest data from the database upon return.\n//\n// Parameters:\n//   - ctx: Context for cancellation and timeout control (reserved for future use)\n//   - agentRun: AgentRun instance to update (must not be nil, must have valid ID).\n//     The struct will be updated with the latest data from the database upon return.\n//\n// Returns:\n//   - error: Error if validation fails, max retries already reached, or database update fails\nfunc (r *RetryOrchestrator) IncrementRetryCount(ctx context.Context, agentRun *models.AgentRun) error {\n\t// Parameter validation\n\tif agentRun == nil","signatures":{"ranges":[]},"detailedLines":[{"text":"func (r *RetryOrchestrator) ShouldRetry(agentRun *models.AgentRun) bool {","lineNumber":64,"isSignature":false},{"text":"\tif agentRun == nil {","lineNumber":65,"isSignature":false},{"text":"\t\treturn false","lineNumber":66,"isSignature":false},{"text":"\t}","lineNumber":67,"isSignature":false},{"text":"","lineNumber":68,"isSignature":false},{"text":"\tshouldRetry := agentRun.RetryCount < MaxRetryCount","lineNumber":69,"isSignature":false},{"text":"","lineNumber":70,"isSignature":false},{"text":"\tr.logger.Debug(\"Checking if retry is allowed\",","lineNumber":71,"isSignature":false},{"text":"\t\tzap.Int(\"agent_run_id\", agentRun.ID),","lineNumber":72,"isSignature":false},{"text":"\t\tzap.Int(\"retry_count\", agentRun.RetryCount),","lineNumber":73,"isSignature":false},{"text":"\t\tzap.Int(\"max_retry_count\", MaxRetryCount),","lineNumber":74,"isSignature":false},{"text":"\t\tzap.Bool(\"should_retry\", shouldRetry),","lineNumber":75,"isSignature":false},{"text":"\t\tzap.String(\"service\", \"retry_orchestrator\"),","lineNumber":76,"isSignature":false},{"text":"\t)","lineNumber":77,"isSignature":false},{"text":"","lineNumber":78,"isSignature":false},{"text":"\treturn shouldRetry","lineNumber":79,"isSignature":false},{"text":"}","lineNumber":80,"isSignature":false},{"text":"","lineNumber":81,"isSignature":false},{"text":"// IncrementRetryCount increments the retry count for an AgentRun and saves it to the database.","lineNumber":82,"isSignature":false},{"text":"// This method does NOT perform state transitions - it only updates the retry_count field.","lineNumber":83,"isSignature":false},{"text":"//","lineNumber":84,"isSignature":false},{"text":"// The method enforces the maximum retry limit (MaxRetryCount = 50). If the retry count","lineNumber":85,"isSignature":false},{"text":"// has already reached or exceeded the maximum, this method returns an error and does","lineNumber":86,"isSignature":false},{"text":"// not increment the count. This prevents retry_count from exceeding the configured maximum.","lineNumber":87,"isSignature":false},{"text":"//","lineNumber":88,"isSignature":false},{"text":"// This method uses an atomic UPDATE query at the repository level to prevent lost increments","lineNumber":89,"isSignature":false},{"text":"// under concurrent retries. The atomic operation ensures that even if multiple calls happen","lineNumber":90,"isSignature":false},{"text":"// simultaneously, each increment will be applied correctly without race conditions.","lineNumber":91,"isSignature":false},{"text":"// The caller's agentRun parameter is updated with the latest data from the database upon return.","lineNumber":92,"isSignature":false},{"text":"//","lineNumber":93,"isSignature":false},{"text":"// Parameters:","lineNumber":94,"isSignature":false},{"text":"//   - ctx: Context for cancellation and timeout control (reserved for future use)","lineNumber":95,"isSignature":false},{"text":"//   - agentRun: AgentRun instance to update (must not be nil, must have valid ID).","lineNumber":96,"isSignature":false},{"text":"//     The struct will be updated with the latest data from the database upon return.","lineNumber":97,"isSignature":false},{"text":"//","lineNumber":98,"isSignature":false},{"text":"// Returns:","lineNumber":99,"isSignature":false},{"text":"//   - error: Error if validation fails, max retries already reached, or database update fails","lineNumber":100,"isSignature":false},{"text":"func (r *RetryOrchestrator) IncrementRetryCount(ctx context.Context, agentRun *models.AgentRun) error {","lineNumber":101,"isSignature":false},{"text":"\t// Parameter validation","lineNumber":102,"isSignature":false},{"text":"\tif agentRun == nil","lineNumber":103,"isSignature":false}]},"score":0.3939509391784668},{"codeBlock":{"relativeWorkspacePath":"specs/001-github-agent-automation/contracts/retry-decision-tree.md","range":{"startPosition":{"line":320,"column":0},"endPosition":{"line":407,"column":0}},"contents":"**Example**:\n```\nAgentRun retry_count = 10\nagent-runner reports to Operator (5 API retry attempts)\nIf all fail: retry_count becomes 11 (AI retry triggered)\n```\n\n---\n\n## Implementation\n\n### RetryOrchestrator Service (internal/services/retry_orchestrator.go)\n\n```go\npackage services\n\ntype RetryOrchestrator struct {\n\tagentRunRepo AgentRunRepository\n\tjobService   KubernetesJobService\n}\n\nfunc (r *RetryOrchestrator) ShouldRetry(agentRun *AgentRun) bool {\n\treturn agentRun.RetryCount < 50\n}\n\nfunc (r *RetryOrchestrator) TriggerRetry(agentRun *AgentRun, feedback string) error {\n\t// Increment retry count\n\tagentRun.RetryCount++\n\tif err := r.agentRunRepo.Update(agentRun); err != nil {\n\t\treturn err\n\t}\n\n\t// Check limit\n\tif agentRun.RetryCount >= 50 {\n\t\treturn r.handleMaxRetriesExceeded(agentRun)\n\t}\n\n\t// Aggregate feedback and create new Job\n\tprompt := r.buildRetryPrompt(agentRun, feedback)\n\treturn r.jobService.CreateJob(agentRun, prompt)\n}\n\nfunc (r *RetryOrchestrator) handleMaxRetriesExceeded(agentRun *AgentRun) error {\n\tagentRun.State = \"failed\"\n\t// Post GitHub comment\n\t// Send Discord notification\n\treturn r.agentRunRepo.Update(agentRun)\n}\n```\n\n---\n\n## Edge Cases\n\n### 1. Same Error Repeated 3 Times\n\n**Problem**: Agent stuck in infinite loop with same error\n\n**Detection**:\n- Hash of (error_message + ci_logs + review_comments)\n- If hash matches previous 3 consecutive attempts → pause\n\n**Action**:\n- Post GitHub comment: \"⚠️ Same error detected 3 times. Pausing auto-retry. Please review.\"\n- Do NOT increment retry_count\n- Require manual reset via CLI: `operator retry <run-id> --reset-count`\n\n---\n\n### 2. Partial Success (Lint Passed, CI Failed Later)\n\n**Problem**: Should retry count include partial successes?\n\n**Answer**: Yes, any failure triggers +1 increment\n\n**Reason**: The goal is to reach fully working code, not partial progress\n\n---\n\n### 3. Codex Never Responds\n\n**Problem**: PR created, but Codex bot never posts review\n\n**Action**:\n- Spec requires **manual intervention** (FR-010 clarification)\n- System does NOT poll for Codex response","signatures":{"ranges":[]},"detailedLines":[{"text":"**Example**:","lineNumber":322,"isSignature":false},{"text":"```","lineNumber":323,"isSignature":false},{"text":"AgentRun retry_count = 10","lineNumber":324,"isSignature":false},{"text":"agent-runner reports to Operator (5 API retry attempts)","lineNumber":325,"isSignature":false},{"text":"If all fail: retry_count becomes 11 (AI retry triggered)","lineNumber":326,"isSignature":false},{"text":"```","lineNumber":327,"isSignature":false},{"text":"","lineNumber":328,"isSignature":false},{"text":"---","lineNumber":329,"isSignature":false},{"text":"","lineNumber":330,"isSignature":false},{"text":"## Implementation","lineNumber":331,"isSignature":false},{"text":"","lineNumber":332,"isSignature":false},{"text":"### RetryOrchestrator Service (internal/services/retry_orchestrator.go)","lineNumber":333,"isSignature":false},{"text":"","lineNumber":334,"isSignature":false},{"text":"```go","lineNumber":335,"isSignature":false},{"text":"package services","lineNumber":336,"isSignature":false},{"text":"","lineNumber":337,"isSignature":false},{"text":"type RetryOrchestrator struct {","lineNumber":338,"isSignature":false},{"text":"\tagentRunRepo AgentRunRepository","lineNumber":339,"isSignature":false},{"text":"\tjobService   KubernetesJobService","lineNumber":340,"isSignature":false},{"text":"}","lineNumber":341,"isSignature":false},{"text":"","lineNumber":342,"isSignature":false},{"text":"func (r *RetryOrchestrator) ShouldRetry(agentRun *AgentRun) bool {","lineNumber":343,"isSignature":false},{"text":"\treturn agentRun.RetryCount < 50","lineNumber":344,"isSignature":false},{"text":"}","lineNumber":345,"isSignature":false},{"text":"","lineNumber":346,"isSignature":false},{"text":"func (r *RetryOrchestrator) TriggerRetry(agentRun *AgentRun, feedback string) error {","lineNumber":347,"isSignature":false},{"text":"\t// Increment retry count","lineNumber":348,"isSignature":false},{"text":"\tagentRun.RetryCount++","lineNumber":349,"isSignature":false},{"text":"\tif err := r.agentRunRepo.Update(agentRun); err != nil {","lineNumber":350,"isSignature":false},{"text":"\t\treturn err","lineNumber":351,"isSignature":false},{"text":"\t}","lineNumber":352,"isSignature":false},{"text":"","lineNumber":353,"isSignature":false},{"text":"\t// Check limit","lineNumber":354,"isSignature":false},{"text":"\tif agentRun.RetryCount >= 50 {","lineNumber":355,"isSignature":false},{"text":"\t\treturn r.handleMaxRetriesExceeded(agentRun)","lineNumber":356,"isSignature":false},{"text":"\t}","lineNumber":357,"isSignature":false},{"text":"","lineNumber":358,"isSignature":false},{"text":"\t// Aggregate feedback and create new Job","lineNumber":359,"isSignature":false}