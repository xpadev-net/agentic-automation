sSignature":false},{"text":"","lineNumber":210,"isSignature":false},{"text":"\t// Verify AgentRun updated","lineNumber":211,"isSignature":false},{"text":"\tvar updated models.AgentRun","lineNumber":212,"isSignature":false},{"text":"\trequire.NoError(t, db.First(&updated, run.ID).Error)","lineNumber":213,"isSignature":false},{"text":"\tassert.Equal(t, \"failed\", updated.State)","lineNumber":214,"isSignature":false},{"text":"\tassert.Equal(t, \"claude-code\", updated.AgentType)","lineNumber":215,"isSignature":false},{"text":"\tif assert.NotNil(t, updated.CompletedAt) {","lineNumber":216,"isSignature":false},{"text":"\t\tassert.WithinDuration(t, time.Now(), *updated.CompletedAt, time.Minute)","lineNumber":217,"isSignature":false},{"text":"\t}","lineNumber":218,"isSignature":false},{"text":"\t// Retry count should remain 0 (US2では自動再試行しない)","lineNumber":219,"isSignature":false},{"text":"\tassert.Equal(t, 0, updated.RetryCount)","lineNumber":220,"isSignature":false},{"text":"","lineNumber":221,"isSignature":false},{"text":"\t// Verify audit log recorded with event_type=agent-run.failed","lineNumber":222,"isSignature":false}]},"score":0.3256455659866333},{"codeBlock":{"relativeWorkspacePath":"agent-runner/pkg/reporter/client_test.go","range":{"startPosition":{"line":391,"column":1},"endPosition":{"line":458,"column":47}},"contents":"func TestIsRetryableError_NetworkTemporary(t *testing.T) {\n\terr := &temporaryError{temporary: true}\n\tgot := isRetryableError(err, 0)\n\tif !got {\n\t\tt.Errorf(\"isRetryableError(temporary error, 0) = %v, want true\", got)\n\t}\n}\n\nfunc TestIsRetryableError_DNSError(t *testing.T) {\n\terr := &net.DNSError{\n\t\tErr:         \"no such host\",\n\t\tName:        \"test.example.com\",\n\t\tServer:      \"8.8.8.8\",\n\t\tIsTimeout:   false,\n\t\tIsTemporary: false,\n\t}\n\tgot := isRetryableError(err, 0)\n\tif !got {\n\t\tt.Errorf(\"isRetryableError(DNS error, 0) = %v, want true\", got)\n\t}\n}\n\n// Helper types for testing network errors\ntype timeoutError struct {\n\ttimeout bool\n}\n\nfunc (e *timeoutError) Error() string   { return \"timeout error\" }\nfunc (e *timeoutError) Timeout() bool   { return e.timeout }\nfunc (e *timeoutError) Temporary() bool { return false }\n\ntype temporaryError struct {\n\ttemporary bool\n}\n\nfunc (e *temporaryError) Error() string   { return \"temporary error\" }\nfunc (e *temporaryError) Timeout() bool   { return false }\nfunc (e *temporaryError) Temporary() bool { return e.temporary }\n\n// ============================================================================\n// Retry Logic Tests\n// ============================================================================\n\nfunc TestCalculateBackoffDelay(t *testing.T) {\n\ttests := []struct {\n\t\tattempt int\n\t\twant    time.Duration\n\t}{\n\t\t{1, 0},\n\t\t{2, 1 * time.Second}, // 2^(2-2) * 1s = 1s\n\t\t{3, 2 * time.Second}, // 2^(3-2) * 1s = 2s\n\t\t{4, 4 * time.Second}, // 2^(4-2) * 1s = 4s\n\t\t{5, 8 * time.Second}, // 2^(5-2) * 1s = 8s\n\t}\n\n\tfor _, tt := range tests {\n\t\tt.Run(fmt.Sprintf(\"attempt_%d\", tt.attempt), func(t *testing.T) {\n\t\t\tgot := calculateBackoffDelay(tt.attempt)\n\t\t\tif got != tt.want {\n\t\t\t\tt.Errorf(\"calculateBackoffDelay(%d) = %v, want %v\", tt.attempt, got, tt.want)\n\t\t\t}\n\t\t})\n\t}\n}\n\nfunc TestReportSuccess_RetryOn5xx(t *testing.T)","signatures":{"ranges":[]},"detailedLines":[{"text":"func TestIsRetryableError_NetworkTemporary(t *testing.T) {","lineNumber":394,"isSignature":false},{"text":"\terr := &temporaryError{temporary: true}","lineNumber":395,"isSignature":false},{"text":"\tgot := isRetryableError(err, 0)","lineNumber":396,"isSignature":false},{"text":"\tif !got {","lineNumber":397,"isSignature":false},{"text":"\t\tt.Errorf(\"isRetryableError(temporary error, 0) = %v, want true\", got)","lineNumber":398,"isSignature":false},{"text":"\t}","lineNumber":399,"isSignature":false},{"text":"}","lineNumber":400,"isSignature":false},{"text":"","lineNumber":401,"isSig