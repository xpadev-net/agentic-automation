agent-automation/tasks.md","range":{"startPosition":{"line":227,"column":0},"endPosition":{"line":258,"column":0}},"contents":"- [ ] T109 [P] [US4] Create CI status aggregator from check_suite events in internal/services/ci_status_aggregator.go\n- [ ] T110 [US4] Implement merge conflict detector via GitHub API in internal/services/merge_conflict_detector.go\n- [ ] T111 [US4] Create auto-merge service with merge API call in internal/services/auto_merge.go\n- [ ] T112 [US4] Implement webhook handler for status events (CI completion) in internal/webhooks/handlers/status.go\n- [ ] T113 [US4] Add merge condition re-evaluation on Codex approval comment in internal/webhooks/handlers/pr_review_comment.go\n- [ ] T114 [US4] Add merge condition re-evaluation on CI success in internal/webhooks/handlers/check_suite.go\n- [ ] T115 [US4] Implement merge failure handling and notification in internal/services/auto_merge.go\n- [ ] T116 [US4] Add GitHub status comment for merge success/failure in internal/services/github_notification.go\n- [ ] T117 [US4] Add Discord notification for merge events in internal/services/discord_notification.go\n\n### Tests for User Story 4 (Test-First Development)\n\n- [ ] T118 [P] [US4] Write unit tests for MergeConditionChecker (DoD validation)\n- [ ] T119 [P] [US4] Write unit tests for AutoMergeService (GitHub merge API call)\n- [ ] T120 [US4] Write integration test for approve + CI success → auto-merge flow\n\n**Checkpoint**: All user stories 1-4 should now be independently functional - complete automation from comment to merge\n\n---\n\n## Phase 7: User Story 5 - ブロック解除によるタスク再開 (Priority: P3)\n\n**Goal**: 依存関係を持つタスクがブロックされている場合、完了によりブロックが解消されたタスクに自動着手する\n\n**Independent Test**: 依存関係グラフでブロック解除時に次タスク実行が開始されること\n\n### Implementation for User Story 5\n\n- [ ] T121 [P] [US5] Implement Issue blocker parser (\"blocked by\" / \"blocking\" syntax) in internal/services/issue_blocker_parser.go\n- [ ] T122 [P] [US5] Create directed graph data structure for dependencies in internal/utils/dependency_graph.go\n- [ ] T123 [US5] Implement blocker graph builder from Issue metadata in internal/services/blocker_graph.go","signatures":{"ranges":[]},"detailedLines":[{"text":"- [ ] T109 [P] [US4] Create CI status aggregator from check_suite events in internal/services/ci_status_aggregator.go","lineNumber":228,"isSignature":false},{"text":"- [ ] T110 [US4] Implement merge conflict detector via GitHub API in internal/services/merge_conflict_detector.go","lineNumber":229,"isSignature":false},{"text":"- [ ] T111 [US4] Create auto-merge service with merge API call in internal/services/auto_merge.go","lineNumber":230,"isSignature":false},{"text":"- [ ] T112 [US4] Implement webhook handler for status events (CI completion) in internal/webhooks/handlers/status.go","lineNumber":231,"isSignature":false},{"text":"- [ ] T113 [US4] Add merge condition re-evaluation on Codex approval comment in internal/webhooks/handlers/pr_review_comment.go","lineNumber":232,"isSignature":false},{"text":"- [ ] T114 [US4] Add merge condition re-evaluation on CI success in internal/webhooks/handlers/check_suite.go","lineNumber":233,"isSignature":false},{"text":"- [ ] T115 [US4] Implement merge failure handling and notification in internal/services/auto_merge.go","lineNumber":234,"isSignature":false},{"text":"- [ ] T116 [US4] Add GitHub status comment for merge success/failure in internal/services/github_notification.go","lineNumber":235,"isSignature":false},{"text":"- [ ] T117 [US4] Add Discord notification for merge events in internal/services/discord_notification.go","lineNumber":236,"isSignature":false},{"text":"","lineNumber":237,"isSignature":false},{"text":"### Tests for User Story 4 (Test-First Development)","lineNumber":238,"isSignature":false},{"text":"","lineNumber":239,"isSignature":false},{"text":"- [ ] T118 [P] [US4] Write unit tests for MergeConditionChecker (DoD validation)","lineNumber":240,"isSignature":false},{"text":"- [ ] T119 [P] [US4] Write unit tests for AutoMergeService (GitHub merge API call)","lineNumber":241,"isSignature":false},{"text":"- [ ] T120 [US4] Write integration test for approve + CI success → auto-merge flow","lineNumber":242,"isSignature":false},{"text":"","lineNumber":243,"isSignature":false},{"text":"**Checkpoint**: All user stories 1-4 should now be independently functional - complete automation from comment to merge","lineNumber":244,"isSignature":false},{"text":"","lineNumber":245,"isSignature":false},{"text":"---","lineNumber":246,"isSignature":false},{"text":"","lineNumber":247,"isSignature":false},{"text":"## Phase 7: User Story 5 - ブロック解除によるタスク再開 (Priority: P3)","lineNumber":248,"isSignature":false},{"text":"","lineNumber":249,"isSignature":false},{"text":"**Goal**: 依存関係を持つタスクがブロックされている場合、完了によりブロックが解消されたタスクに自動着手する","lineNumber":250,"isSignature":false},{"text":"","lineNumber":251,"isSignature":false},{"text":"**Independent Test**: 依存関係グラフでブロック解除時に次タスク実行が開始されること","lineNumber":252,"isSignature":false},{"text":"","lineNumber":253,"isSignature":false},{"text":"### Implementation for User Story 5","lineNumber":254,"isSignature":false},{"text":"","lineNumber":255,"isSignature":false},{"text":"- [ ] T121 [P] [US5] Implement Issue blocker parser (\"blocked by\" / \"blocking\" syntax) in internal/services/issue_blocker_parser.go","lineNumber":256,"isSignature":false},{"text":"- [ ] T122 [P] [US5] Create directed graph data structure for dependencies in internal/utils/dependency_graph.go","lineNumber":257,"isSignature":false},{"text":"- [ ] T123 [US5] Implement blocker graph builder from Issue metadata in internal/services/blocker_graph.go","lineNumber":258,"isSignature":false}]},"score":0.3298511505126953},{"codeBlock":{"relativeWorkspacePath":"specs/001-github-agent-automation/data-model.md","range":{"startPosition":{"line":115,"column":0},"endPosition":{"line":177,"column":0}},"contents":"- github_comment_id: INT (nullable) - **NEW**: GitHub comment ID for tracking\n- created_at: DATETIME\n- updated_at: DATETIME\n\n**Relationships**:\n- belongs to PullRequest (via pr_id)\n\n**Indexes**:\n- INDEX(pr_id) - for querying reviews by PR\n- INDEX(approval_detected) - for finding approved PRs\n\n### CIStatus\n\n**NEW ENTITY** - Tracks GitHub Check Suite results for PR validation\n\n- id: INT (PK, auto-increment)\n- pr_id: INT (FK to PullRequest.id)\n- check_suite_id: STRING (GitHub check suite ID)\n- check_run_id: STRING (nullable, specific check run ID)\n- name: STRING (e.g., \"build\", \"test\", \"lint\")\n- status: ENUM(queued/in_progress/completed)\n- conclusion: ENUM(success/failure/cancelled/skipped/neutral) (nullable until completed)\n- logs: TEXT (nullable) - **CI failure logs for AI retry context**\n- logs_url: STRING (nullable) - **GitHub logs URL**\n- started_at: DATETIME (nullable)\n- completed_at: DATETIME (nullable)\n- created_at: DATETIME\n- updated_at: DATETIME\n\n**Relationships**:\n- belongs to PullRequest (via pr_id)\n\n**Indexes**:\n- UNIQUE(pr_id, check_suite_id, check_run_id) - prevent duplicate CI records\n- INDEX(pr_id, status) - for querying active CI runs\n- INDEX(conclusion) - for finding failed checks\n\n**Business Rules**:\n- A PR is \"CI passing\" when ALL CIStatus records for latest commit have conclusion=success\n- Failed checks (conclusion=failure) trigger AI retry with logs as context\n\n### BlockerGraphEdges\n\nAdjacency list for Issue dependency graph (directed graph)\n\n- task_id: INT (FK to Issue.id, PK composite)\n- depends_on_task_id: INT (FK to Issue.id, PK composite)\n- created_at: DATETIME\n\n**Relationships**:\n- task_id references Issue (the blocked task)\n- depends_on_task_id references Issue (the blocking task)\n\n**Indexes**:\n- PRIMARY KEY(task_id, depends_on_task_id)\n- INDEX(depends_on_task_id) - for finding all tasks blocked by a specific Issue\n\n**Business Rules**:\n- When Issue X closes, query `depends_on_task_id = X` to find blocked tasks\n- Blocked task Y becomes unblocked when ALL its dependencies are closed\n- Cycle detection via DFS before starting execution","signatures":{"ranges":[]},"detailedLines":[{"text":"- github_comment_id: INT (nullable) - **NEW**: GitHub comment ID for tracking","lineNumber":116,"isSignature":false},{"text":"- created_at: DATETIME","lineNumber":117,"isSignature":false},{"text":"- updated_at: DATETIME","lineNumber":118,"isSignature":false},{"text":"","lineNumber":119,"isSignature":false},{"text":"**Relationships**:","lineNumber":120,"isSignature":false},{"text":"- belongs to PullRequest (via pr_id)","lineNumber":121,"isSignature":false},{"text":"","lineNumber":122,"isSignature":false},{"text":"**Indexes**:","lineNumber":123,"isSignature":false},{"text":"- INDEX(pr_id) - for querying reviews by PR","lineNumber":124,"isSignature":false},{"text":"- INDEX(approval_detected) - for finding approved PRs","lineNumber":125,"isSignature":false},{"text":"","lineNumber":126,"isSignature":false},{"text":"### CIStatus","lineNumber":127,"isSignature":false},{"text":"","lineNumber":128,"isSignature":false},{"text":"**NEW ENTITY** - Tracks GitHub Check Suite results for PR validation","lineNumber":129,"isSignature":false},{"text":"","lineNumber":130,"isSignature":false},{"text":"- id: INT (PK, auto-increment)","lineNumber":131,"isSignature":false},{"text":"- pr_id: INT (FK to PullRequest.id)","lineNumber":132,"isSignature":false},{"text":"- check_suite_id: STRING (GitHub check suite ID)","lineNumber":133,"isSignature":false},{"text":"- check_run_id: STRING (nullable, specific check run ID)","lineNumber":134,"isSignature":false},{"text":"- name: STRING (e.g., \"build\", \"test\", \"lint\")","lineNumber":135,"isSignature":false},{"text":"- status: ENUM(queued/in_progress/completed)","lineNumber":136,"isSignature":false},{"text":"- conclusion: ENUM(success/failure/cancelled/skipped/neutral) (nullable until completed)","lineNumber":137,"isSignature":false},{"text":"- logs: TEXT (nullable) - **CI failure logs for AI retry context**","lineNumber":138,"i