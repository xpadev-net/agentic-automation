 536|\treturn checkSuite, nil\n   537|}\n   538|\n   539|// ListCheckRunsForCheckSuite retrieves all check runs for a check suite\n   540|// Handles pagination to return all check runs, not just the first page\n   541|func (c *Client) ListCheckRunsForCheckSuite(ctx context.Context, owner, repo string, checkSuiteID int64) ([]*github.CheckRun, error) {\n   542|\tc.logger.Info(\"Listing GitHub check runs for check suite\",\n   543|\t\tzap.String(\"owner\", owner),\n   544|\t\tzap.String(\"repo\", repo),\n   545|\t\tzap.Int64(\"check_suite_id\", checkSuiteID),\n   546|\t)\n   547|\n   548|\topts := &github.ListCheckRunsOptions{\n   549|\t\tListOptions: github.ListOptions{\n   550|\t\t\tPage:    1,\n   551|\t\t\tPerPage: 100, // Maximum per page to minimize API calls\n   552|\t\t},\n   553|\t}\n   554|\n   555|\tvar allCheckRuns []*github.CheckRun\n   556|\tvar resp *github.Response\n   557|\n   558|\tfor {\n   559|\t\tcheckRunsResult, pageResp, err := c.Checks.ListCheckRunsCheckSuite(ctx, owner, repo, checkSuiteID, opts)\n   560|\t\tif err != nil {\n   561|\t\t\treturn nil, c.handleError(err, pageResp, \"ListCheckRunsForCheckSuite\")\n   562|\t\t}\n   563|\n   564|\t\tallCheckRuns = append(allCheckRuns, checkRunsResult.CheckRuns...)\n   565|\t\tresp = pageResp\n   566|\n   567|\t\tif resp.NextPage == 0 {\n   568|\t\t\tbreak\n   569|\t\t}\n   570|\n   571|\t\topts.Page = resp.NextPage\n   572|\t}\n   573|\n   574|\tc.handleRateLimit(resp)\n   575|\treturn allCheckRuns, nil\n   576|}\n   577|\n   578|// GetCheckRunLogs retrieves logs for a specific check run\n   579|// Note: GitHub API doesn't provide direct logs endpoint, so this uses the check run details\n   580|// The actual logs URL is available in CheckRun.HTMLURL\n   581|func (c *Client) GetCheckRunLogs(ctx context.Context, owner, repo string, checkRunID int64) (string, error) {\n   582|\tc.logger.Info\n</search_result>\n<search_result path=\"internal/models/webhook_events.go\" startLine=\"1\" endLine=\"66\">\n     1|package models\n     2|\n     3|// Package models provides data models and type definitions for the GitHub Agent Automation system.\n     4|// This file contains constants and helper functions for GitHub webhook event types and actions.\n     5|\n     6|// Webhook event types supported by the system\n     7|const (\n     8|\tEventTypeIssueComment             = \"issue_comment\"\n     9|\tEventTypeIssues                   = \"issues\"\n    10|\tEventTypePullRequest              = \"pull_request\"\n    11|\tEventTypePullRequestReview        = \"pull_request_review\"\n    12|\tEventTypePullRequestReviewComment = \"pull_request_review_comment\"\n    13|\tEventTypeCheckSuite               = \"check_suite\"\n    14|\tEventTypeStatus                   = \"status\"\n    15|)\n    16|\n    17|// Webhook action values for each event type\n    18|const (\n    19|\t// issue_comment actions\n    20|\tIssueCommentActionCreated = \"created\"\n    21|\n    22|\t// issues actions\n    23|\tIssuesActionClosed   = \"closed\"\n    24|\tIssuesActionReopened = \"reopened\"\n    25|\n    26|\t// pull_request actions\n    27|\tPullRequestActionOpened      = \"opened\"\n    28|\tPullRequestActionSynchronize = \"synchronize\"\n    29|\tPullRequestActionClosed      = \"closed\"\n    30|\n    31|\t// pull_request_review actions\n    32|\tPullRequestReviewActionSubmitted = \"submitted\"\n    33|\n    34|\t// pull_request_review_comment actions\n    35|\tPullRequestReviewCommentActionCreated = \"created\"\n    36|\n    37|\t// check_suite actions\n    38|\tCheckSuiteActionCompleted = \"completed\"\n    39|)\n    40|\n    41|// check_suite conclusion values\n    42|const (\n    43|\tCheckSuiteConclusionSuccess   = \"success\"\n    44|\tCheckSuiteConclusionFailure   = \"failure\"\n    45|\tCheckSuiteConclusionCancelled = \"cancelled\"\n    46|\tCheckSuiteConclusionSkipped   = \"skipped\"\n    47|\tCheckSuiteConclusionNeutral   = \"neutral\"\n    48|)\n    49|\n    50|// status event state values\n    51|const (\n    52|\tStatusStatePending = \"pending\"\n    53|\tStatusStateSuccess = \"success\"\n    54|\tStatusStateFailure = \"failure\"\n    55|\tStatusStateError   = \"error\"\n    56|)\n    57|\n    58|// IsValidEventType checks if the provided event type is a valid/supported webhook event type.\n    59|// It returns true if eventType matches one of the defined event type constants.\n    60|//\n    61|// Parameters:\n    62|//   - eventType: The event type string to validate (e.g., \"issue_comment\", \"pull_request\")\n    63|//\n    64|// Returns:\n    65|//   - bool: true if the event type is valid, false otherwise\n    66|func IsValidEventType(eventType string) bool\n</search_result>\n<search_result path=\"specs/001-github-agent-automation/contracts/github-webhooks.md\" startLine=\"185\" endLine=\"367\">\n   185|**Purpose**: Detect Codex approval for auto-merge\n   186|\n   187|**Webhook Payload**:\n   188|\n   189|```json\n   190|{\n   191|  \"action\": \"submitted\",\n   192|  \"review\": {\n   193|    \"id\": 111222,\n   194|    \"body\": \"Codex Review: Didn't find any major issues.\",\n   195|    \"user\": {\n   196|      \"login\": \"codex-bot\"\n   197|    },\n   198|    \"state\": \"approved\"\n   199|  },\n   200|  \"pull_request\": {\n   201|    \"number\": 101\n   202|  },\n   203|  \"repository\": {\n   204|    \"full_name\": \"octocat/hello-world\"\n   205|  }\n   206|}\n   207|```\n   208|\n   209|**Processing**:\n   210|\n   211|1. Check if `review.user.login` is Codex bot\n   212|2. Parse `review.body` for approval pattern:\n   213|   - Regex: `/didn't find.*major issues/i`\n   214|   - Or exact: \"Codex Review: Didn't find any major issues.\"\n   215|3. Create ReviewFeedback record with `approval_detected: true`\n   216|4. Re-evaluate merge conditions (MergeConditionChecker)\n   217|5. If all conditions met, call AutoMergeService\n   218|6. Log to AuditLog\n   219|\n   220|---\n   221|\n   222|### 5. pull_request_review_comment\n   223|\n   224|Triggered when a comment is made on a PR review (inline code comments).\n   225|\n   226|**Purpose**: Detect `@codex review` requests in PR comments\n   227|\n   228|**Webhook Payload**:\n   229|\n   230|```json\n   231|{\n   232|  \"action\": \"created\",\n   233|  \"comment\": {\n   234|    \"id\": 333444,\n   235|    \"body\": \"@codex review\",\n   236|    \"user\": {\n   237|      \"login\": \"octocat\"\n   238|    }\n   239|  },\n   240|  \"pull_request\": {\n   241|    \"number\": 101\n   242|  },\n   243|  \"repository\": {\n   244|    \"full_name\": \"octocat/hello-world\"\n   245|  }\n   246|}\n   247|```\n   248|\n   249|**Processing**:\n   250|\n   251|1. Check if `comment.body` contains `@codex review`\n   252|2. Verify user has permission\n   253|3. Call CodexReviewService to request review\n   254|4. Create ReviewFeedback record with status=requested\n   255|5. Log to AuditLog\n   256|\n   257|---\n   258|\n   259|### 6. check_suite (FR-014)\n   260|\n   261|Triggered when a CI check suite is completed.\n   262|\n   263|**Purpose**: Detect CI pass/fail for auto-merge and AI retry\n   264|\n   265|**Actions Subscribed**: `completed`\n   266|\n   267|**Webhook Payload**:\n   268|\n   269|```json\n   270|{\n   271|  \"action\": \"completed\",\n   272|  \"check_suite\": {\n   273|    \"id\": 555666,\n   274|    \"status\": \"completed\",\n   275|    \"conclusion\": \"success\",\n   276|    \"head_branch\": \"feature/issue-42\",\n   277|    \"head_sha\": \"abc123def456\",\n   278|    \"pull_requests\": [\n   279|      {\n   280|        \"number\": 101\n   281|      }\n   282|    ]\n   283|  },\n   284|  \"repository\": {\n   285|    \"full_name\": \"octocat/hello-world\"\n   286|  }\n   287|}\n   288|```\n   289|\n   290|**Conclusion Values**:\n   291|- `success`: All checks passed\n   292|- `failure`: One or more checks failed\n   293|- `cancelled`: Checks were cancelled\n   294|- `skipped`: Checks were skipped\n   295|- `neutral`: Checks completed with neutral status\n   296|\n   297|**Processing**:\n   298|\n   299|1. Find PullRequest by number\n   300|2. Create/update CIStatus record\n   301|3. If `conclusion: failure`:\n   302|   - Fetch logs via GitHub API\n   303|   - Parse failure reason\n   304|   - Pass to RetryOrchestrator\n   305|   - Aggregate with ReviewFeedback\n   306|   - Trigger AI retry (increment AgentRun.retry_count)\n   307|4. If `conclusion: success`:\n   308|   - Re-evaluate merge conditions\n   309|   - If all conditions met, call AutoMergeService\n   310|5. Log to AuditLog\n   311|\n   312|**Precedence & De-duplication with `status` events**:\n   313|\n   314|- `check_suite` を優先シグナルとし、`status` はレガシー互換として使用する。\n   315|- 両方が発火した場合は `head_sha` が同一かつ最新のタイムスタンプのイベントを採用し二重処理を避ける。\n   316|- 既存の CIStatus レコード更新は idempotent に設計する（同一 `head_sha` の重複更新は無害）。\n   317|\n   318|---\n   319|\n   320|### 7. status\n   321|\n   322|Triggered when commit status changes (legacy CI systems).\n   323|\n   324|**Purpose**: Support legacy CI systems that don't use check suites\n   325|\n   326|**Webhook Payload**:\n   327|\n   328|```json\n   329|{\n   330|  \"sha\": \"abc123def456\",\n   331|  \"state\": \"success\",\n   332|  \"description\": \"Build passed\",\n   333|  \"context\": \"ci/travis\",\n   334|  \"target_url\": \"https://travis-ci.org/...\",\n   335|  \"branches\": [\n   336|    {\n   337|      \"name\": \"feature/issue-42\"\n   338|    }\n   339|  ],\n   340|  \"repository\": {\n   341|    \"full_name\": \"octocat/hello-world\"\n   342|  }\n   343|}\n   344|```\n   345|\n   346|**State Values**: `pending`, `success`, `failure`, `error`\n   347|\n   348|**Processing**: Similar to check_suite, but use `state` field instead of `conclusion`\n   349|\n   350|---\n   351|\n   352|## Security\n   353|\n   354|### Signature Verification\n   355|\n   356|All webhooks MUST be verified using HMAC-SHA256 (Go example):\n   357|\n   358|```go\n   359|import (\n   360|  \"crypto/hmac\"\n   361|  \"crypto/sha256\"\n   362|  \"encoding/hex\"\n   363|)\n   364|\n   365|func verifySignature(payload []byte, signature, secret string) bool {\n   366|  mac := hmac.New(sha256.New, []byte(secret))\n   367|  mac.Write(payload)\n</search_result>\n\n<search_result path=\"internal/webhooks/handlers/pr_review_comment.go\" startLine=\"87\" endLine=\"158\"></search_result>\n<search_result path=\"internal/webhooks/handlers/issue_comment.go\" startLine=\"145\" endLine=\"216\"></search_result>\n<search_result path=\"internal/webhooks/server.go\" startLine=\"121\" endLine=\"201\"></search_result>\n<search_result path=\"internal/webhooks/handlers/pr_review_comment.go\" startLine=\"153\" endLine=\"213\"></search_result>\n<search_result path=\"internal/webhooks/middleware/idempotency.go\" endLine=\"45\"></search_result>\n<search_result path=\"internal/webhooks/server.go\" endLine=\"75\"></search_result>\n<search_result path=\"internal/webhooks/middleware/idempotency.go\" startLine=\"248\" endLine=\"313\"></search_result>\n<search_result path=\"internal/webhooks/handlers/issue_comment.go\" startLine=\"269\" endLine=\"327\"></search_result>\n<search_result path=\"internal/webhooks/handlers/agent_report.go\" startLine=\"452\" endLine=\"497\"></search_result>\n<search_result path=\"specs/001-github-agent-automation/tasks.md\" startLine=\"171\" endLine=\"200\"></search_result>\n<search_result path=\"internal/services/ci_failure.go\" startLine=\"84\" endLine=\"153\"></search_result>\n<search_result path=\"internal/webhooks/handlers/agent_report.go\" startLine=\"42\" endLine=\"118\"></search_result>\n<search_result path=\"internal/webhooks/handlers/agent_report.go\" endLine=\"44\"></search_result>\n<search_result path=\"internal/webhooks/middleware/signature.go\" startLine=\"48\" endLine=\"93\"></search_result>","codeResults":[{"codeBlock":{"relativeWorkspacePath":"internal/webhooks/handlers/check_suite.go","range":{"startPosition":{"line":0,"column":0},"endPosition":{"line":19,"column":0}},"con