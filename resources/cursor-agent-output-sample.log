ogger.Info(\"Ignoring non-created action\",\n\t\t\tzap.String(\"action\", payload.Action),\n\t\t\tzap.String(\"delivery_id\", deliveryID),\n\t\t\tzap.Int(\"pr_number\", payload.PullRequest.Number),\n\t\t\tzap.String(\"repo\", payload.Repository.FullName),\n\t\t)\n\t\tc.JSON(http.StatusOK, gin.H{\n\t\t\t\"status\":      \"ignored\",\n\t\t\t\"action\":      payload.Action,\n\t\t\t\"delivery_id\": deliveryID,\n\t\t})\n\t\treturn\n\t}\n\n\t// Step 5: トリガー検出\n\tlogger.Info(\"Checking for trigger in comment\",\n\t\tzap.String(\"delivery_id\", deliveryID),","signatures":{"ranges":[]},"detailedLines":[{"text":"func HandlePullRequestReviewCommentWithDeps(c *gin.Context, deps PullRequestReviewCommentDeps) {","lineNumber":89,"isSignature":false},{"text":"\t// Step 1: Initialization","lineNumber":90,"isSignature":false},{"text":"\tlogger := deps.Logger","lineNumber":91,"isSignature":false},{"text":"\tif logger == nil {","lineNumber":92,"isSignature":false},{"text":"\t\tlogger = config.GetLogger()","lineNumber":93,"isSignature":false},{"text":"\t}","lineNumber":94,"isSignature":false},{"text":"","lineNumber":95,"isSignature":false},{"text":"\t// Create context","lineNumber":96,"isSignature":false},{"text":"\tctx := c.Request.Context()","lineNumber":97,"isSignature":false},{"text":"","lineNumber":98,"isSignature":false},{"text":"\t// Step 2: Delivery ID 取得","lineNumber":99,"isSignature":false},{"text":"\tdeliveryID := c.GetHeader(deliveryHeader)","lineNumber":100,"isSignature":false},{"text":"\tif deliveryID == \"\" {","lineNumber":101,"isSignature":false},{"text":"\t\tlogger.Warn(\"Missing X-GitHub-Delivery header\",","lineNumber":102,"isSignature":false},{"text":"\t\t\tzap.String(\"path\", c.Request.URL.Path),","lineNumber":103,"isSignature":false},{"text":"\t\t)","lineNumber":104,"isSignature":false},{"text":"\t\tc.Error(errors.New(\"missing X-GitHub-Delivery header\"))","lineNumber":105,"isSignature":false},{"text":"\t\treturn","lineNumber":106,"isSignature":false},{"text":"\