)\n// - Error type detection via isRetryableError (done above)\n// - File operations (directory creation, file handling)\n//\n// The actual S3 retry logic (PutObject/GetObject retries) would require\n// mocking the AWS SDK v2 *s3.Client, which is a concrete type that cannot\n// be easily mocked without interface abstraction.\n//\n// For now, we'll test what we can and note the limitations.\n// Full retry behavior should be tested in integration tests (T066_S3).\n\n// TestClient_Upload_Success tests successful upload scenario","signatures":{"ranges":[]},"detailedLines":[{"text":"\tassert.True(t, result)","lineNumber":679,"isSignature":false},{"text":"}","lineNumber":680,"isSignature":false},{"text":"","lineNumber":681,"isSignature":false},{"text":"func TestIsRetryableError_AccessDenied(t *testing.T) {","lineNumber":682,"isSignature":false},{"text":"\terr := createNonRetryableError(\"AccessDenied\", 403)","lineNumber":683,"isSignature":false},{"text":"\tresult := TestIsRetryableError(err)","lineNumber":684,"isSignature":false},{"text":"\tassert.False(t, result)","lineNumber":685,"isSignature":false},{"text":"}","lineNumber":686,"isSignature":false},{"text":"","lineNumber":687,"isSignature":false},{"text":"func TestIsRetryableError_NotFound(t *testing.T) {","lineNumber":688,"isSignature":false},{"text":"\terr := createNonRetryableError(\"NotFound\", 404)","lineNumber":689,"isSignature":false},{"text":"\tresult := TestIsRetryableError(err)","lineNumber":690,"isSignature":false},{"text":"\tassert.False(t, result)","lineNumber":691,"isSignature":false},{"text":"}","lineNumber":692,"isSignature":false},{"text":"","lineNumber":693,"isSignature":false},{"text":"func TestIsRetryableError_Forbidden(t *testing.T) {","lineNumber":694,"isSignature":false},{"text":"\terr := createNonRetryableError(\"Forbidden\", 403)","lineNumber":695,"isSignature":false},{"text":"\tresult := TestIsRetryableError(err)","lineNumber":696,"isSignature":false},{"text":"\tassert.False(t, result)","line