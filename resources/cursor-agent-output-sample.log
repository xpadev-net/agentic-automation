eckRunsResult, pageResp, err := c.Checks.ListCheckRunsCheckSuite(ctx, owner, repo, checkSuiteID, opts)\n\t\tif err != nil {\n\t\t\treturn nil, c.handleError(err, pageResp, \"ListCheckRunsForCheckSuite\")\n\t\t}\n\n\t\tallCheckRuns = append(allCheckRuns, checkRunsResult.CheckRuns...)\n\t\tresp = pageResp\n\n\t\tif resp.NextPage == 0 {\n\t\t\tbreak\n\t\t}\n\n\t\topts.Page = resp.NextPage\n\t}\n\n\tc.handleRateLimit(resp)\n\treturn allCheckRuns, nil\n}\n\n// GetCheckRunLogs retrieves logs for a specific check run\n// Note: GitHub API doesn't provide direct logs endpoint, so this uses the check run details\n// The actual logs URL is available in CheckRun.HTMLURL\nfunc (c *Client) GetCheckRunLogs(ctx context.Context, owner, repo string, checkRunID int64) (string, error) {\n\tc.logger.Info","signatures":{"ranges":[]},"detailedLines":[{"text":"func (c *Client) GetCheckSuite(ctx context.Context, owner, repo string, checkSuiteID int64) (*github.CheckSuite, error) {","lineNumber":523,"isSignature":false},{"text":"\tc.logger.Info(\"Getting GitHub check suite\",","lineNumber":524,"isSignature":false},{"text":"\t\tzap.String(\"owner\", owner),","lineNumber":525,"isSignature":false},{"text":"\t\tzap.String(\"repo\", repo),","lineNumber":526,"isSignature":false},{"text":"\t\tzap.Int64(\"check_suite_id\", checkSuiteID),","lineNumber":527,"isSignature":false},{"text":"\t)","lineNumber":528,"isSignature":false},{"text":"","lineNumber":529,"isSignature":false},{"text":"\tcheckSuite, resp, err := c.Checks.GetCheckSuite(ctx, owner, repo, checkSuiteID)","lineNumber":530,"isSignature":false},{"text":"\tif err != nil {","lineNumber":531,"isSignature":false},{"text":"\t\treturn nil, c.handleError(err, resp, \"GetCheckSuite\")","lineNumber":532,"isSignature":false},{"text":"\t}","lineNumber":533,"isSignature":false},{"text":"","lineNumber":534,"isSignature":false},{"text":"\tc.handleRateLimit(resp)","lineNumber":535,"isSignature":false},{"text":"\treturn checkSuite, nil","lineNumber":536,"is