"column:github_issue_id;type:bigint unsigned;index\"` // GitHub's numeric issue ID\n\tTitle         string    `gorm:\"size:512\"`\n\tBody          *string   `gorm:\"type:text\"`\n\tLabels        string    `gorm:\"type:json\"` // JSON array stored as string, parsed in application layer\n\tState         string    `gorm:\"type:enum('open','closed');default:'open'\"`\n\tCreatedAt     time.Time `gorm:\"column:created_at;autoCreateTime\"`\n\tUpdatedAt     time.Time `gorm:\"column:updated_at;autoUpdateTime\"`\n\n\t// Relationships\n\tAgentRuns         []AgentRun         `gorm:\"foreignKey:IssueID;constraint:OnDelete:CASCADE\"`\n\tPullRequests      []PullRequest      `gorm:\"foreignKey:IssueID;constraint:OnDelete:SET NULL\"`\n\tBlockerGraphEdges []BlockerGraphEdge `gorm:\"foreignKey:TaskID;constraint:OnDelete:CASCADE\"`\n\tDependencyEdges   []BlockerGraphEdge `gorm:\"foreignKey:DependsOnTaskID;constraint:OnDelete:CASCADE\"`\n}\n\n// TableName specifies the table name for Issue\nfunc (Issue) TableName() string {\n\treturn \"issues\"\n}","signatures":{"ranges":[]},"detailedLines":[{"text":"package models","lineNumber":1,"isSignature":false},{"text":"","lineNumber":2,"isSignature":false},{"text":"import (","lineNumber":3,"isSignature":false},{"text":"\t\"time\"","lineNumber":4,"isSignature":false},{"text":")","lineNumber":5,"isSignature":false},{"text":"","lineNumber":6,"isSignature":false},{"text":"// Issue represents a GitHub Issue","lineNumber":7,"isSignature":false},{"text":"type Issue struct {","lineNumber":8,"isSignature":false},{"text":"\tID            int       `gorm:\"primaryKey;autoIncrement\"`","lineNumber":9,"isSignature":false},{"text":"\tRepo          string    `gorm:\"size:255;index:idx_issue_repo_number,unique\"`","lineNumber":10,"isSignature":false},{"text":"\tNumber        int       `gorm:\"index:idx_issue_repo_number,unique\"`","lineNumber":11,"isSignature":false},{"text":"\tGitHubIssueID uint64    `gorm:\"column:github_issue_id;type:bigint unsigned;index\"` // GitHub's numeric issue ID","lineNumber":12,"isSignature":false},{"text":"\tTitle         string    `gorm:\"size:512\"`","lineNumber":13,"isSignature":false},{"text":"\tBody          *string   `gorm:\"type:text\"`","lineNumber":14,"isSignature":false},{"text":"\tLabels        string    `gorm:\"type:json\"` // JSON array stored as string, parsed in application layer","lineNumber":15,"isSignature":false},{"text":"\tState         string    `gorm:\"type:enum('open','closed');default:'open'\"`","lineNumber":16,"isSignature":false},{"text":"\tCreatedAt     time.Time `gorm:\"column:created_at;autoCreateTime\"`","lineNumber":17,"isSignature":false},{"text":"\tUpdatedAt     time.Time `gorm:\"column:updated_at;autoUpdateTime\"`","lineNumber":18,"isSignature":false},{"text":"","lineNumber":19,"isSignature":false},{"text":"\t// Relationships","lineNumber":20,"isSignature":false},{"text":"\tAgentRuns         []AgentRun         `gorm:\"foreignKey:IssueID;constraint:OnDelete:CASCADE\"`","lineNumber":21,"isSignature":false},{"text":"\tPullRequests      []PullRequest      `gorm:\"foreignKey:IssueID;constraint:OnDelete:SET NULL\"`","lineNumber":22,"isSignature":false},{"text":"\tBlockerGraphEdges []BlockerGraphEdge `gorm:\"foreignKey:TaskID;constraint:OnDelete:CASCADE\"`","lineNumber":23,"isSignature":false},{"text":"\tDependencyEdges   []BlockerGraphEdge `gorm:\"foreignKey:DependsOnTaskID;constraint:OnDelete:CASCADE\"`","lineNumber":24,"isSignature":false},{"text":"}","lineNumber":25,"isSignature":false},{"text":"","lineNumber":26,"isSignature":false},{"text":"// TableName specifies the table name for Issue","lineNumber":27,"isSignature":false},{"text":"func (Issue) TableName() string {","lineNumber":28,"isSignature":false},{"text":"\treturn \"issues\"","lineNumber":29,"isSignature":false},{"text":"}","lineNumber":30,"isSignature":false}]},"score":0.3128781020641327},{"codeBlock":{"relativeWorkspacePath":"specs/001-github-agent-automation/tasks.md","range":{"startPosition":{"line":425,"column":0},"endPosition":{"line":475,"column":0}},"contents":"- **Idempotency**: Every webhook handler uses X-GitHub-Delivery for deduplication (T024)\n- **Retry logic**: All external API calls use exponential backoff utility (T022)\n- **Max 50 retries**: Enforced in RetryOrchestrator (T052, T055)\n- **Notifications**: Dual channel (GitHub + Discord) for all failures (FR-008, FR-014)\n- **Authorization**: Collaborator+ check in every webhook handler (FR-018, T028)\n- **DoD**: CI success + Codex approve + no conflicts (SC-009)\n\n### Success Criteria Mapping\n\n- SC-001 (2min to start): US1 webhook processing + K8s Job creation (T053, T055)\n- SC-002 (15min to PR): agent-runner execution in Pod (T030-T048)\n- SC-003 (10min retry): US3 feedback loop + K8s Job re-creation (T113-T081)\n- SC-004 (no duplicates): Idempotency middleware (T024)\n- SC-005 (5min unblock): US5 blocker resolution (T126-T128)\n- SC-006 (5min CI retry): US3 check_suite handler (T111-T112)\n- SC-007 (2min merge): US4 auto-merge (T111)\n- SC-008 (immediate notification): US3 failure notifications (T083-T084)\n- SC-009 (DoD conditions): US4 merge checker (T108)\n\n### Edge Cases Addressed\n\n- Duplicate webhooks: T024 idempotency middleware\n- Review response missing: T113 retry orchestrator with timeout\n- Merge conflicts: T110 conflict detector blocks auto-merge\n- Unlimited concurrency: No locking (運用側考慮 per FR-012)\n- Circular dependencies: T124 cycle detector prevents deadlock\n- Rate limits: T135 rate limiting for GitHub API\n- Database queries: T140, T146 optimize with SQL indexes (goose)\n- Operator API unreachable: agent-runner exponential backoff retry (T038, T047)\n\n### GORM Model Highlights\n\n```go\ntype AgentRun struct {\n  IdempotencyKey string `gorm:\"uniqueIndex\"` // X-GitHub-Delivery\n  RetryCount     int    `gorm:\"default:0\"`   // Max 50\n  State          string // queued/started/succeeded/failed\n  // ... other fields\n}\n\ntype BlockerGraphEdge struct {\n  TaskID          int `gorm:\"primaryKey\"`\n  DependsOnTaskID int `gorm:\"primaryKey\"`\n}\n```\n\n---\n\n**Total Tasks**: 147 tasks organized across 8 phases","signatures":{"ranges":[]},"detailedLines":[{"text":"- **Idempotency**: Every webhook handler uses X-GitHub-Delivery for deduplication (T024)","lineNumber":426,"isSignature":false},{"text":"- **Retry logic**: All external API calls use exponential backoff utility (T022)","lineNumber":427,"isSignature":false},{"text":"- **Max 50 retries**: Enforced in RetryOrchestrator (T052, T055)","lineNumber":428,"isSignature":false},{"text":"- **Notifications**: Dual channel (GitHub + Discord) for all failures (FR-008, FR-014)","lineNumber":429,"isSignature":false},{"text":"- **Authorization**: Collaborator+ check in every webhook handler (FR-018, T028)","lineNumber":430,"isSignature":false},{"text":"- **DoD**: CI success + Codex approve + no conflicts (SC-009)","lineNumber":431,"isSignature":false},{"text":"","lineNumber":432,"isSignature":false},{"text":"### Success Criteria Mapping","lineNumber":433,"isSignature":false},{"text":"","lineNumber":434,"isSignature":false},{"text":"- SC-001 (2min to start): US1 webhook processing + K8s Job creation (T053, T055)","lineNumber":435,"isSignature":false},{"text":"- SC-002 (15min to PR): agent-runner execution in Pod (T030-T048)","lineNumber":436,"isSignature":false},{"text":"- SC-003 (10min retry): US3 feedback loop + K8s Job re-creation (T113-T081)","lineNumber":437,"isSignature":false},{"text":"- SC-004 (no duplicates): Idempotency middleware (T024)","lineNumber":438,"isSignature":false},{"text":"- SC-005 (5min unblock): US5 blocker resolution (T126-T128)","lineNumber":439,"isSignature":false},{"text":"- SC-006 (5min CI retry): US3 check_suite handler (T111-T112)","lineNumber":440,"isSignature":false},{"text":"- SC-007 (2min merge): US4 auto-merge (T111)","lineNumber":441,"isSignature":false},{"text":"- SC-008 (immediate notification): US3 failure notifications (T083-T084)","lineNumber":442,"isSignature":false},{"text":"- SC-009 (DoD conditions): US4 merge checker (T108)","lineNumber":443,"isSignature":false},{"text":"","lineNumber":444,"isSignature":false},{"text":"### Edge Cases Addressed","lineNumber":445,"isSignature":false},{"text":"","lineNumber":446,"isSignature":false},{"text":"- Duplicate webhooks: T024 idempotency middleware","lineNumber":447,"isSignature":false},{"text":"- Review response missing: T113 retry orchestrator with timeout","lineNumber":448,"isSignature":false},{"text":"- Merge conflicts: T110 conflict detector blocks auto-merge","lineNumber":449,"isSignature":false},{"text":"- Unlimited concurrency: No locking (運用側考慮 per FR-012)","lineNumber":450,"isSignature":false},{"text":"- Circular dependencies: T124 cycle detector prevents deadlock","lineNumber":451,"isSignature":false},{"text":"- Rate limits: T135 rate limiting for GitHub API","lineNumber":452,"isSignature":false},{"text":"- Database queries: T140, T146 optimize with SQL indexes (goose)","lineNumber":453,"isSignature":false},{"text":"- Operator API unreachable: agent-runner exponential backoff retry (T038, T047)","lineNumber":454,"isSignature":false},{"text":"","lineNumber":455,"isSignature":false},{"text":"### GORM Model Highlights","lineNumber":456,"isSignature":false},{"text":"","lineNumber":457,"isSignature":false},{"text":"```go","lineNumber":458,"isSignature":false},{"text":"type AgentRun struct {","lineNumber":459,"isSignature":false},{"text":"  IdempotencyKey string `gorm:\"uniqueIndex\"` // X-GitHub-Delivery","lineNumber":460,"isSignature":false},{"text":"  RetryCount     int    `gorm:\"default:0\"`   // Max 50","lineNumber":461,"isSignature":false},{"text":"  State          string // queued/started/succeeded/failed","lineNumber":462,"isSignature":false},{"text":"  // ... other fields","lineNumber":463,"isSignature":false},{"text":"}","lineNumber":464,"isSignature":false},{"text":"","lineNumber":465,"isSignature":false},{"text":"type BlockerGraphEdge struct {","lineNumber":466,"isSignature":false},{"text":"  TaskID          int `gorm:\"primaryKey\"`","lineNumber":467,"isSignature":false},{"text":"  DependsOnTaskID int `gorm:\"primaryKey\"`","lineNumber":468,"isSignature":false},{"text":"}","lineNumber":469,"isSignature":false},{"text":"```","lineNumber":470,"isSignature":false},{"text":"","lineNumber":471,"isSignature":false},{"text":"---","lineNumber":472,"isSignature":false},{"text":"","lineNumber":473,"isSignature":false},{"text":"**Total Tasks**: 147 tasks organized across 8 phases","lineNumber":474,"isSignature":false}]},"score":0.31068259477615356},{"codeBlock":{"relativeWorkspacePath":"specs/001-github-agent-automation/tasks.md","range":{"startPosition":{"line":375,"column":0},"endPosition":{"line":427,"column":0}},"contents":"```\n\n---\n\n## Implementation Strategy\n\n### MVP First (User Stories 1 + 2 Only)\n\n1. Complete Phase 1: Setup (7 tasks)\n2. Complete Phase 2: Foundational (17 tasks) - CRITICAL foundation with GORM + goose\n3. Complete Phase 3: User Story 1 (10 tasks)\n4. Complete Phase 4: User Story 2 (11 tasks)\n5. **STOP and VALIDATE**: Test end-to-end flow from comment to PR\n6. Deploy to staging environment\n\n**MVP Value**: Automated PR creation from Issue comments - immediate productivity gain\n\n### Incremental Delivery\n\n1. **Foundation** (Phase 1+2): 24 tasks → GORM + goose, webhooks, core infrastructure ready\n2. **MVP** (+US1+US2): 21 tasks → Comment triggers AI agent, creates PR automatically\n3. **Quality Loop** (+US3): 14 tasks → Automatic improvements via Codex review + CI retry (max 50)\n4. **Full Automation** (+US4): 10 tasks → Auto-merge on approval - zero human intervention\n5. **Dependency Management** (+US5): 11 tasks → Sequential task execution with blocking\n6. **Production Ready** (+Polish): 14 tasks → Monitoring, docs, security hardening\n\nTotal: 94 tasks (comparable scope using GORM + goose)\n\n### Parallel Team Strategy\n\nWith multiple developers after Foundational phase:\n\n1. **Team completes Phase 1+2 together** (24 tasks, foundational with GORM + goose)\n2. **Split work:**\n   - Developer A: User Story 1 (webhook triggers)\n   - Developer B: User Story 2 (AI + PR creation) - can work with stub from US1\n   - Developer C: User Story 5 (dependency graph) - completely independent\n3. **Sequential enhancements:**\n   - Developer B continues to US3 (review loop) after US2\n   - Developer B continues to US4 (auto-merge) after US3\n4. **Final integration:** Merge all stories, test interactions\n5. **Polish together:** Phase 8 can be parallelized across team\n\n---\n\n## Notes\n\n- **[P] tasks**: Different files, no dependencies - safe to parallelize\n- **[Story] labels**: Map tasks to user stories from spec.md for traceability\n- **GORM**: Type-safe database access with ORM (T008-T010)\n- **Idempotency**: Every webhook handler uses X-GitHub-Delivery for deduplication (T024)\n- **Retry logic**: All external API calls use exponential backoff utility (T022)","signatures":{"ranges":[]},"detailedLines":[{"text":"```","lineNumber":376,"isSignature":false},{"text":"","lineNumber":377,"isSignature":false},{"text":"---","lineNumber":378,"isSignature":false},{"text":"","lineNumber":379,"isSignature":false},{"text":"## Implementation Strategy","lineNumber":380,"isSignature":false},{"text":"","lineNumber":381,"isSignature":false},{"text":"### MVP First (User Stories 1 + 2 Only)","lineNumber":382,"isSignature":false},{"text":"","lineNumber":383,"isSignature":false},{"text":"1. Complete Phase 1: Setup (7 tasks)","lineNumber":384,"isSignature":false},{"text":"2. Complete Phase 2: Foundational (17 tasks) - CRITICAL foundation with GORM + goose","lineNumber":385,"isSignature":false},{"text":"3. Complete Phase 3: User Story 1 (10 tasks)","lineNumber":386,"isSignature":false},{"text":"4. Complete Phase 4: User Story 2 (11 tasks)","lineNumber":387,"isSignature":false},{"text":"5. **STOP and VALIDATE**: Test end-to-end flow from comment to PR","lineNumber":388,"isSignature":false},{"text":"6. Deploy to staging environment","lineNumber":389,"isSignature":false},{"text":"","lineNumber":390,"isSignature":false},{"text":"**MVP Value**: Automated PR creation from Issue comments - immediate productivity gain","lineNumber":391,"isSignature":false},{"text":"","lineNumber":392,"isSignature":false},{"text":"### Incremental Delivery","lineNumber":393,"isSignature":false},{"text":"","lineNumber":394,"isSignature":false},{"text":"1. **Foundation** (Phase 1+2): 24 tasks → GORM + goose, webhooks, core infrastructure ready","lineNumber":395,"isSignature":false},{"text":"2. **MVP** (+US1+US2): 21 tasks → Comment triggers AI agent, creates PR automatically","lineNumber":396,"isSignature":false},{"text":"3. **Quality Loop** (+US3): 14 tasks → Automatic improvements via Codex review + CI retry (max 50)","lineNumber":397,"isSignature":false},{"text":"4. **Full Automation** (+US4): 10 tasks → Auto-merge on approval - zero human intervention","lineNumber":398,"isSignature":false},{"text":"5. **Dependency Management** (+US5): 11 tasks → Sequential task execution with blocking","lineNumber":399,"isSignature":false},{"text":"6. **Production Ready** (+Polish): 14 tasks → Monitoring, docs, security hardening","lineNumber":400,"isSignature":false},{"text":"","lineNumber":401,"isSignature":false},{"text":"Total: 94 tasks (comparable scope using GORM + goose)","lineNumber":402,"isSignature":false},{"text":"","lineNumber":403,"isSignature":false},{"text":"### Parallel Team Strategy","lineNumber":404,"isSignature":false},{"text":"","lineNumber":405,"isSignature":false},{"text":"With multiple developers after Foundational phase:","lineNumber":406,"isSignature":false},{"text":"","lineNumber":407,"isSignature":false},{"text":"1. **Team completes Phase 1+2 together** (24 tasks, foundational with GORM + goose)","lineNumber":408,"isSignature":false},{"text":"2. **Split work:**","lineNumber":409,"isSignature":false},{"text":"   - Developer A: User Story 1 (webhook triggers)","lineNumber":410,"isSignature":false},{"text":"   - Developer B: User Story 2 (AI + PR creation) - can work with stub from US1","lineNumber":411,"isSignature":false},{"text":"   - Developer C: User Story 5 (dependency graph) - completely independent","lineNumber":412,"isSignature":false},{"text":"3. **Sequential enhancements:**","lineNumber":413,"isSignature":false},{"text":"   - Developer B continues to US3 (review loop) after US2","lineNumber":414,"isSignature":false},{"text":"   - Developer B continues to US4 (auto-merge) after US3","lineNumber":415,"isSignature":false},{"text":"4. **Final integration:** Merge all stories, test interactions","lineNumber":416,"isSignature":false},{"text":"5. **Polish together:** Phase 8 can be parallelized across team","lineNumber":417,"isSignature":false},{"text":"","lineNumber":418,"isSignature":false},{"text":"---","lineNumber":419,"isSignature":false},{"text":"","lineNumber":420,"isSignature":false},{"text":"## Notes","lineNumber":421,"isSignature":false},{"text":"","lineNumber":422,"isSignature":false},{"text":"- **[P] tasks**: Different files, no dependencies - safe to parallelize","lineNumber":423,"isSignature":false},{"text":"- **[Story] labels**: Map tasks to user stories from spec.md for traceability","lineNumber":424,"isSignature":false},{"text":"- **GORM**: Type-safe database access with ORM (T008-T010)","lineNumber":425,"isSignature":false},{"text":"- **Idempotency**: Every webhook handler uses X-GitHub-Delivery for deduplication (T024)","lineNumber":426,"isSignature":false},{"text":"- **Retry logic**: All external API calls use exponential backoff utility (T022)","lineNumber":427,"isSignature":false}]},"score":0.2940177023410797},{"codeBlock":{"relativeWorkspacePath":"specs/001-github-agent-automation/migrations/000001_init.sql","range":{"startPosition":{"line":89,"column":0},"endPosition":{"line":127,"column":0}},"contents":"-- Table: ci_status\nCREATE TABLE IF NOT EXISTS ci_status (\n    id INT AUTO_INCREMENT PRIMARY KEY,\n    pr_id INT NOT NULL,\n    check_suite_id VARCHAR(191) NOT NULL,\n    check_run_id VARCHAR(191),\n    name VARCHAR(191) NOT NULL,\n    status ENUM('queued', 'in_progress', 'completed') NOT NULL DEFAULT 'queued',\n    conclusion ENUM('success', 'failure', 'cancelled', 'skipped', 'neutral'),\n    logs TEXT,\n    logs_url VARCHAR(512),\n    started_at DATETIME,\n    completed_at DATETIME,\n    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n    updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,\n\n    UNIQUE KEY uk_ci_status_unique (pr_id, check_suite_id, check_run_id),\n    INDEX idx_ci_status_pr_status (pr_id, status),\n    INDEX idx_ci_status_conclusion (conclusion),\n    FOREIGN KEY fk_ci_status_pr (pr_id) REFERENCES pull_requests(id) ON DELETE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;\n\n-- Table: blocker_graph_edges\nCREATE TABLE IF NOT EXISTS blocker_graph_edges (\n    task_id INT NOT NULL,\n    depends_on_task_id INT NOT NULL,\n    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n\n    PRIMARY KEY pk_blocker_graph (task_id, depends_on_task_id),\n    INDEX idx_blocker_depends_on (depends_on_task_id),\n    FOREIGN KEY fk_blocker_task (task_id) REFERENCES issues(id) ON DELETE CASCADE,\n    FOREIGN KEY fk_blocker_depends (depends_on_task_id) REFERENCES issues(id) ON DELETE CASCADE\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;\n\n-- Table: audit_logs\nCREATE TABLE IF NOT EXISTS audit_logs (\n    id INT AUTO_INCREMENT PRIMARY KEY,\n    event_type VARCHAR(191) NOT NULL,","signatures":{"ranges":[]},"detailedLines":[{"text":"-- Table: ci_status","lineNumber":90,"isSignature":false},{"text":"CREATE TABLE IF NOT EXISTS ci_status (","lineNumber":91,"isSignature":false},{"text":"    id INT AUTO_INCREMENT PRIMARY KEY,","lineNumber":92,"isSignature":false},{"text":"    pr_id INT NOT NULL,","lineNumber":93,"isSignature":false},{"text":"    chec