tedge := models.BlockerGraphEdge{\n    48|\t\tTaskID:          taskID,\n    49|\t\tDependsOnTaskID: dependsOnTaskID,\n    50|\t}\n    51|\n    52|\tresult := r.db.Create(&edge)\n    53|\tif result.Error != nil {\n    54|\t\t// Check if error is due to duplicate key (idempotent behavior)\n    55|\t\tif isDuplicateKeyError(result.Error) {\n    56|\t\t\treturn nil // Silently ignore duplicate edges\n    57|\t\t}\n    58|\t\treturn result.Error\n    59|\t}\n    60|\n    61|\treturn nil\n    62|}\n    63|\n    64|// CreateEdges creates multiple dependency edges in batch\n    65|// Duplicate edges are silently ignored (idempotent operation)\n    66|func (r *BlockerGraphRepository) CreateEdges(edges []models.BlockerGraphEdge) error {\n    67|\tif len(edges) == 0 {\n    68|\t\treturn nil\n    69|\t}\n    70|\n    71|\t// Create edges one by one, ignoring duplicates\n    72|\t// CreateEdge already handles duplicate key errors gracefully\n    73|\tfor _, edge := range edges {\n    74|\t\tif err := r.CreateEdge(edge.TaskID, edge.DependsOnTaskID); err != nil {\n    75|\t\t\t// CreateEdge already handles duplicate errors, so any error here is unexpected\n    76|\t\t\treturn err\n    77|\t\t}\n    78|\t}\n    79|\n    80|\treturn nil\n    81|}\n    82|\n    83|// DeleteEdge deletes a specific dependency edge\n    84|func (r *BlockerGraphRepository) DeleteEdge(taskID, dependsOnTaskID int) error {\n    85|\tresult := r.db.Where(\"task_id = ? AND depends_on_task_id = ?\", taskID, dependsOnTaskID).\n    86|\t\tDelete(&models.BlockerGraphEdge{})\n    87|\n    88|\tif result.Error != nil {\n    89|\t\treturn result.Error\n    90|\t}\n    91|\n    92|\treturn nil\n    93|}\n    94|\n    95|// GetDependenciesForTask returns all dependencies for a given task\n    96|// Returns edges where task_id = taskID (tasks that this task depends on)\n    97|// Returns empty slice (not nil) if no dependencies found\n    98|func (r *BlockerGraphRepository) GetDependenciesForTask(taskID int) ([]models.BlockerGraphEdge, error) {\n    99|\tvar edges []models.BlockerGraphEdge\n   100|\n   101|\tresult := r.db.Where(\"task_id = ?\", taskID).Find(&edges)\n   102|\tif result.Error != nil {\n   103|\t\treturn nil, result.Error\n   104|\t}\n   105|\n   106|\t// Return empty slice instead of nil\n   107|\tif edges == nil {\n   108|\t\tedges = []models.BlockerGraphEdge{}\n   109|\t}\n   110|\n   111|\treturn edges, nil\n   112|}\n   113|\n   114|// FindTasksBlockedBy returns all tasks that are blocked by a specific issue\n   115|// Returns edges where depends_on_task_id = issueID (tasks waiting for this issue to complete)\n   116|// Returns empty slice (not nil) if no tasks found\n   117|func (r *BlockerGraphRepository) FindTasksBlockedBy(issueID int) ([]models.BlockerGraphEdge, error) {\n   118|\tvar edges []models.BlockerGraphEdge\n   119|\n   120|\tresult := r.db.Where(\"depends_on_task_id = ?\", issueID).Find(&edges)\n   121|\tif result.Error != nil {\n   122|\t\treturn nil, result.Error\n   123|\t}\n   124|\n   125|\t// Return empty slice instead of nil\n   126|\tif edges == nil {\n   127|\t\tedges = []models.BlockerGraphEdge{}\n   128|\t}\n   129|\n   130|\treturn edges, nil\n   131|}\n   132|\n   133|// GetAllEdges returns all edges in the blocker graph\n</search_result>\n<search_result path=\"internal/models/blocker_graph_edge.go\" startLine=\"1\" endLine=\"22\">\n     1|package models\n     2|\n     3|import (\n     4|\t\"time\"\n     5|)\n     6|\n     7|// BlockerGraphEdge represents a dependency edge in the task blocker graph\n     8|// task_id is blocked by depends_on_task_id\n     9|type BlockerGraphEdge struct {\n    10|\tTaskID          int       `gorm:\"column:task_id;primaryKey\"`\n    11|\tDependsOnTaskID int       `gorm:\"column:depends_on_task_id;primaryKey;index\"`\n    12|\tCreatedAt       time.Time `gorm:\"column:created_at;autoCreateTime\"`\n    13|\n    14|\t// Relationships\n    15|\tTask          Issue `gorm:\"foreignKey:TaskID;constraint:OnDelete:CASCADE\"`\n    16|\tDependsOnTask Issue `gorm:\"foreignKey:DependsOnTaskID;constraint:OnDelete:CASCADE\"`\n    17|}\n    18|\n    19|// TableName specifies the table name for BlockerGraphEdge\n    20|func (BlockerGraphEdge) TableName() string {\n    21|\treturn \"blocker_graph_edges\"\n    22|}\n</search_result>\n<search_result path=\"specs/001-github-agent-automation/research.md\" startLine=\"255\" endLine=\"322\">\n   255|**Decision**: State machine with retry counter\n   256|\n   257|**Implementation**:\n   258|- AgentRun.retryCount: increment on each AI retry\n   259|- Max retries: 50 (FR-014)\n   260|- On failure: aggregate CI logs + review comments\n   261|- Pass to AI agent as context for next iteration\n   262|- After 50 attempts: set state=failed, notify GitHub + Discord\n   263|\n   264|### 4.4 Dependency Graph Management\n   265|\n   266|**Decision**: Adjacency list in BlockerGraphEdges table\n   267|\n   268|**Algorithm**:\n   269|- On Issue close: query dependents (tasks blocked by this Issue)\n   270|- Check if all dependencies resolved for each dependent\n   271|- If yes: trigger execution for unblocked tasks\n   272|- Cycle detection: DFS with visited set (warn but don't block)\n   273|\n   274|**Data Model**:\n   275|- Composite PK: (taskId, dependsOnTaskId)\n   276|- Both columns FK to Issue.id\n   277|- Parse \"blocked by #123\" from Issue body using regex\n   278|\n   279|### 4.5 Concurrent Execution\n   280|\n   281|**Decision**: No locking, rely on Git merge conflicts\n   282|\n   283|**Rationale**:\n   284|- Spec requires unlimited concurrency (FR-012)\n   285|- File conflicts detected at PR merge time\n   286|- Simpler than distributed locks\n   287|- User resolves conflicts or closes duplicate Issues\n   288|\n   289|**Risk Mitigation**: Document in quickstart.md that users should manage Issue dependencies\n   290|\n   291|## 5. Performance & Scalability\n   292|\n   293|### 5.1 Rate Limiting\n   294|\n   295|**GitHub API**: 5000 requests/hour for authenticated apps\n   296|- Implement request counter in MetricsService\n   297|- Warn at 80% threshold (4000 req/hr)\n   298|- Backoff if rate limit exceeded\n   299|\n   300|**Codex API**: TBD - implement per-API documentation\n   301|\n   302|### 5.2 Database Optimization\n   303|\n   304|- Index on AgentRun.idempotencyKey (unique)\n   305|- Index on AgentRun.state for querying active runs\n   306|- Index on BlockerGraphEdges.dependsOnTaskId for dependency lookup\n   307|- Index on CIStatus.prId for CI result queries\n   308|- Connection pooling: GORM default (sql.DB with SetMaxOpenConns, SetMaxIdleConns)\n   309|\n   310|### 5.3 Observability\n   311|\n   312|**Metrics**:\n   313|- Webhook processing time (p50, p95, p99)\n   314|- Agent execution time\n   315|- Retry counts per Issue\n   316|- GitHub API request count\n   317|- Success/failure rates\n   318|\n   319|**Logging**:\n   320|- All webhook events (DEBUG level)\n   321|- All external API calls (INFO level)\n   322|- Errors with stack traces (ERROR level)\n</search_result>\n<search_result path=\"specs/001-github-agent-automation/tasks.md\" startLine=\"257\" endLine=\"286\">\n   257|- [ ] T122 [P] [US5] Create directed graph data structure for dependencies in internal/utils/dependency_graph.go\n   258|- [ ] T123 [US5] Implement blocker graph builder from Issue metadata in internal/services/blocker_graph.go\n   259|- [ ] T124 [US5] Create circular dependency detector with cycle detection algorithm in internal/services/circular_dependency_detector.go\n   260|- [ ] T125 [US5] Implement webhook handler for issues events (closed/reopened) in internal/webhooks/handlers/issues.go\n   261|- [ ] T126 [US5] Create blocked task resolver finding unblocked tasks in internal/services/blocked_task.go\n   262|- [ ] T127 [US5] Implement dependency validation preventing out-of-order execution in internal/services/dependency_validator.go\n   263|- [ ] T128 [US5] Implement automatic K8s Job trigger for unblocked tasks in internal/services/blocked_task.go\n   264|- [ ] T129 [US5] Add GitHub status comment for dependency violations in internal/services/github_notification.go\n   265|- [ ] T130 [US5] Add logging for blocker graph updates and task resumption in internal/services/blocked_task.go\n   266|\n   267|### Tests for User Story 5 (Test-First Development)\n   268|\n   269|- [ ] T131 [P] [US5] Write unit tests for IssueBlockerParser (dependency parsing)\n   270|- [ ] T132 [P] [US5] Write unit tests for CircularDependencyDetector (cycle detection)\n   271|- [ ] T133 [US5] Write integration test for Issue close → unblock → auto-trigger flow\n   272|\n   273|**Checkpoint**: All user stories should now be independently functional - complete system with dependency management\n   274|\n   275|---\n   276|\n   277|## Phase 8: Polish & Cross-Cutting Concerns\n   278|\n   279|**Purpose**: Improvements that affect multiple user stories\n   280|\n   281|- [ ] T134 [P] Add comprehensive error messages and user-facing error codes in internal/utils/error_codes.go\n   282|- [ ] T135 [P] Implement rate limiting for GitHub API calls in internal/clients/github.go\n   283|- [ ] T136 [P] Add metrics collection for execution times and success rates in internal/services/metrics.go\n   284|- [ ] T137 [P] Create health check endpoint for webhook server in internal/webhooks/server.go\n   285|- [ ] T138 [P] Add environment variable validation on startup in internal/config/env.go\n   286|- [ ] T139 [P] Implement graceful shutdown handler in internal/webhooks/server.go\n</search_result>\n\n<search_result path=\"specs/001-github-agent-automation/data-model.md\" startLine=\"344\" endLine=\"394\"></search_result>\n<search_result path=\"specs/001-github-agent-automation/data-model.md\" startLine=\"115\" endLine=\"177\"></search_result>\n<search_result path=\"specs/001-github-agent-automation/contracts/github-webhooks.md\" startLine=\"83\" endLine=\"188\"></search_result>\n<search_result path=\"specs/00