","lineNumber":469,"isSignature":false},{"text":"```","lineNumber":470,"isSignature":false},{"text":"","lineNumber":471,"isSignature":false},{"text":"---","lineNumber":472,"isSignature":false},{"text":"","lineNumber":473,"isSignature":false},{"text":"**Total Tasks**: 147 tasks organized across 8 phases","lineNumber":474,"isSignature":false}]},"score":0.20377373695373535},{"codeBlock":{"relativeWorkspacePath":"internal/repositories/agent_run.go","range":{"startPosition":{"line":198,"column":32},"endPosition":{"line":247,"column":87}},"contents":"\tvar updateCondition *gorm.DB\n\tswitch currentState {\n\tcase \"queued\":\n\t\t// queued can only transition to started\n\t\tif state != \"started\" {\n\t\t\treturn &ErrInvalidStateTransition{\n\t\t\t\tCurrentState: currentState,\n\t\t\t\tNewState:     state,\n\t\t\t}\n\t\t}\n\t\tupdateCondition = r.db.Model(&models.AgentRun{}).Where(\"id = ? AND state = ?\", id, currentState)\n\tcase \"started\":\n\t\t// started can transition to succeeded or failed\n\t\tif state != \"succeeded\" && state != \"failed\" {\n\t\t\treturn &ErrInvalidStateTransition{\n\t\t\t\tCurrentState: currentState,\n\t\t\t\tNewState:     state,\n\t\t\t}\n\t\t}\n\t\t// If transitioning to succeeded, verify pr_id is set\n\t\tif state == \"succeeded\" {\n\t\t\tif currentRun.PRID == nil {\n\t\t\t\treturn ErrMissingPRIDForSucceeded\n\t\t\t}\n\t\t\t// Include pr_id IS NOT NULL in WHERE condition to ensure pr_id is still set at update time\n\t\t\tupdateCondition = r.db.Model(&models.AgentRun{}).Where(\"id = ? AND state = ? AND pr_id IS NOT NULL\", id, currentState)\n\t\t} else {\n\t\t\t// For failed transition, just check state\n\t\t\tupdateCondition = r.db.Model(&models.AgentRun{}).Where(\"id = ? AND state = ?\", id, currentState)\n\t\t}\n\tdefault:\n\t\t// Unknown current state - reject transition\n\t\treturn &ErrInvalidStateTransition{\n\t\t\tCurrentState: currentState,\n\t\t\tNewState:     state,\n\t\t}\n\t}\n\n\t// Perform the state update atomically using W