,{"text":"","lineNumber":253,"isSignature":false},{"text":"// TestS3Failure_RestoreSessionSkippedOnInitialRun tests that RestoreSession is skipped on initial run","lineNumber":254,"isSignature":false},{"text":"func TestS3Failure_RestoreSessionSkippedOnInitialRun(t *testing.T) {","lineNumber":255,"isSignature":false},{"text":"\t// Setup environment with invalid S3 endpoint","lineNumber":256,"isSignature":false},{"text":"\tsetupS3FailureEnv(t, 1)","lineNumber":257,"isSignature":false}]},"score":0.3226607143878937},{"codeBlock":{"relativeWorkspacePath":"specs/001-github-agent-automation/contracts/retry-decision-tree.md","range":{"startPosition":{"line":119,"column":0},"endPosition":{"line":189,"column":0}},"contents":"2. Apply exponential backoff with jitter:\n   - Attempt 1: immediate\n   - Attempt 2: 1s delay\n   - Attempt 3: 2s delay\n   - Attempt 4: 4s delay\n   - Attempt 5: 8s delay\n3. Maximum 3-5 attempts (depending on API)\n\n**On All Retries Failed**:\n- Log error to AuditLog\n- Send Discord notification (infrastructure issue)\n- For agent-runner → Operator API failure: Pod exits with code 1\n- For GitHub API failure: Proceed with AI retry (+1 to count)\n- For S3 failure (upload/download): Pod exits with code 1 → Operator creates new Job (API Retry)\n\n---\n\n## Detailed Scenarios\n\n### Scenario A: Lint Failed\n\n**Flow**:\n```\n1. agent-runner executes `npm run lint`\n2. Exit code = 1 (failure)\n3. agent-runner reports to Operator: status=failed, error_message=\"Lint failed: ...\"\n4. Operator increments AgentRun.retry_count (+1)\n5. Operator checks: retry_count < 50? → Yes\n6. Operator creates new K8s Job with feedback:\n   - Previous attempt: \"Lint failed at line 42: missing semicolon\"\n7. New agent-runner Pod starts with updated prompt\n```\n\n**Retry Type**: AI Retry (counted)\n\n---\n\n### Scenario B: GitHub API Rate Limit\n\n**Flow**:\n```\n1. agent-runner calls GitHub API to create PR\n2. Response: HTTP 429 Too Many Requests\n3. agent-runner applies exponential backoff\n4. Retry 1: Wait 1s → HTTP 429\n5. Retry 2: Wait 2s → HTTP 429\n6. Retry 3: Wait 4s → HTTP 200 OK (success)\n7. agent-runner reports to Operator: status=succeeded, pr_number=101\n8. AgentRun.retry_count remains unchanged\n```\n\n**Retry Type**: API Retry (not counted)\n\n---\n\n### Scenario C: CI Failed\n\n**Flow**:\n```\n1. Agent execution succeeds, PR created\n2. GitHub triggers CI via GitHub Actions\n3. check_suite webhook: conclusion=failure\n4. Operator parses CI logs: \"Test failed: expected 'foo', got 'bar'\"\n5. Operator increments AgentRun.retry_count (+1)\n6. Operator checks: retry_count < 50? → Yes\n7. Operator creates new K8s Job with feedback:\n   - \"CI Failed: Test assertion error at parser_test.ts:42\"\n8. Agent re-executes with updated prompt\n```","signatures":{"ranges":[]},"detailedLines":[{"text":"2. Apply exponential backoff with jitter:","lineNumber":120,"isSignature":false},{"text":"   - Attempt 1: immediate","lineNumber":121,"isSignature":false},{"text":"   - Attempt 2: 1s delay","lineNumber":122,"isSignature":false},{"text":"   - Attempt 3: 2s delay","lineNumber":123,"isSignature":false},{"text":"   - Attempt 4: 4s delay","lineNumber":124,"isSignature":false},{"text":"   - Attempt 5: 8s delay","lineNumber":125,"isSignature":false},{"text":"3. Maximum 3-5 attempts (depending on API)","lineNumber":126,"isSignature":false},{"text":"","lineNumber":127,"isSignature":false},{"text":"**On All Retries Failed**:","lineNumber":128,"isSignature":false},{"text":"- Log error to AuditLog","lineNumber":129,"isSignature":false},{"text":"- Send Discord notification (infrastructure issue)","lineNumber":130,"isSignature":false},{"text":"- For agent-runner → Operator API failure: Pod exits with code 1","lineNumber":131,"isSignature":false},{"text":"- For GitHub API failure: Proceed with AI retry (+1 to count)","lineNumber":132,"isSignature":false},{"text":"- For S3 failure (upload/download): Pod exits with code 1 → Operator creates new Job (API Retry)","lineNumber":133,"isSignature":false},{"text":"","lineNumber":134,"isSignature":false},{"text":"---","lineNumber":135,"isSignature":false},{"text":"","lineNumber":136,"isSignature":false},{"text":"## Detailed Scenarios","lineNumber":137,"isSignature":false},{"text":"","lineNumber":138,"isSignature":false},{"text":"### Scenario A: Lint Failed","lineNumber":139,"isSignature":false},{"text":"","lineNumber":140,"isSignature":false},{"text":"**Flow**:","lineNumber":141,"isSignature":false},{"text":"```","lineNumber":142,"isSignature":false},{"text":"1. agent-runner executes `npm run lint`","lineNumber":143,"isSignature":false},{"text":"2. Exit code = 1 (failure)","lineNumber":144,"isSignature":false},{"text":"3. agent-runner reports to Operator: status=failed, error_message=\"Lint failed: ...\"","lineNumber":145,"isSignature":false},{"text":"4. Operator increments AgentRun.retry_count (+1)","lineNumber":146,"isSignature":false},{"text":"5. Operator checks: retry_count < 50? → Yes","lineNumber":147,"isSignature":false},{"text":"6. Operator creates new K8s Job with feedback:","lineNumber":148,"isSignature":false},{"text":"   - Previous attempt: \"Lint failed at line 42: missing semicolon\"","lineNumber":149,"isSignature":false},{"text":"7. New agent-runner Pod starts with updated prompt","lineNumber":150,"isSignature":false},{"text":"```","lineNumber":151,"isSignature":false},{"text":"","lineNumber":152,"isSignature":false},{"text":"**Retry Type**: AI Retry (counted)","lineNumber":153,"isSignature":false},{"text":"","lineNumber":154,"isSignature":false},{"text":"---","lineNumber":155,"isSignature":false},{"text":"","lineNumber":156,"isSignature":false},{"text":"### Scenario B: GitHub API Rate Limit","lineNumber":157,"isSignature":false},{"text":"","lineNumber":158,"isSignature":false},{"text":"**Flow**:","lineNumber":159,"isSignature":false},{"text":"```","lineNumber":160,"isSignature":false},{"text":"1. agent-runner calls GitHub API to create PR","lineNumber":161,"isSignature":false},{"text":"2. Response: HTTP 429 Too Many Requests","lineNumber":162,"isSignature":false},{"text":"3. agent-runner applies exponential backoff","lineNumber":163,"isSignature":false},{"text":"4. Retry 1: Wait 1s → HTTP 429","lineNumber":164,"isSignature":false},{"text":"5. Retry 2: Wait 2s → HTTP 429","lineNumber":165,"isSignature":false},{"text":"6. Retry 3: Wait 4s → HTTP 200 OK (success)","lineNumber":166,"isSignature":false},{"text":"7. agent-runner reports to Operator: status=succeeded, pr_number=101","lineNumber":167,"isSignature":false},{"text":"8. AgentRun.retry_count remains unchanged","lineNumber":168,"isSignature":false},{"text":"```","lineNumber":169,"isSignature":false},{"text":"","lineNumber":170,"isSignature":false},{"text":"**Retry Type**: API Retry (not counted)","lineNumber":171,"isSignature":false},{"text":"","lineNumber":172,"isSignature":false},{"text":"---","lineNumber":173,"isSignature":false},{"text":"","lineNumber":174,"isSignature":false},{"text":"### Scenario C: CI Failed","lineNumber":175,"isSignature":false},{"text":"","lineNumber":176,"isSignature":false},{"text":"**Flow**:","lineNumber":177,"isSignature":false},{"text":"```","lineNumber":178,"isSignature":false},{"text":"1. Agent execution succeeds, PR created","lineNumber":179,"isSignature":false},{"text":"2. GitHub triggers CI via GitHub Actions","lineNumber":180,"isSignature":false},{"text":"3. check_suite webhook: conclusion=failure","lineNumber":181,"isSignature":false},{"text":"4. Operator parses CI logs: \"Test failed: expected 'foo', got 'bar'\"","lineNumber":182,"isSignature":false},{"text":"5. Operator increments AgentRun.retry_count (+1)","lineNumber":183,"isSignature":false},{"text":"6. Operator checks: retry_count < 50? → Yes","lineNumber":184,"isSignature":false},{"text":"7. Operator creates new K8s Job with feedback:","lineNumber":185,"isSignature":false},{"text":"   - \"CI Failed: Test assertion error at parser_test.ts:42\"","lineNumber":186,"isSignature":false},{"text":"8. Agent re-executes with updated prompt","lineNumber":187,"isSignature":false},{"text":"```","lineNumber":188,"isSignature":false}]},"score":0.32177770137786865},{"codeBlock":{"relativeWorkspacePath":"agent-runner/pkg/storage/s3_test.go","range":{"startPosition":{"line":605,"column":1},"endPosition":{"line":681,"column":38}},"contents":"func TestIsRetryableError_ServiceUnavailable(t *testing.T) {\n\terr := createRetryableError(\"ServiceUnavailable\", 503)\n\tresult := TestIsRetryableError(err)\n\tassert.True(t, result)\n}\n\nfunc TestIsRetryableError_InternalServerError(t *testing.T) {\n\terr := createRetryableError(\"InternalServerError\", 500)\n\tresult := TestIsRetryableError(err)\n\tassert.True(t, result)\n}\n\nfunc TestIsRetryableError_BadGateway(t *testing.T) {\n\terr := createRetryableError(\"BadGateway\", 502)\n\tresult := TestIsRetryableError(err)\n\tassert.True(t, result)\n}\n\nfunc TestIsRetryableError_GatewayTimeout(t *testing.T) {\n\terr := createRetryableError(\"GatewayTimeout\", 504)\n\tresult := TestIsRetryableError(err)\n\tassert.True(t, result)\n}\n\nfunc TestIsRetryableError_HTTP429(t *testing.T) {\n\terr := &mockHTTPError{statusCode: 429, message: \"Too Many Requests\"}\n\tresult := TestIsRetryableError(err)\n\tassert.True(t, result)\n}\n\nfunc TestIsRetryableError_HTTP5xx(t *testing.T) {\n\ttestCases := []struct {\n\t\tname       string\n\t\tstatusCode int\n\t}{\n\t\t{\"500\", 500},\n\t\t{\"502\", 502},\n\t\t{\"503\", 503},\n\t\t{\"504\", 504},\n\t}\n\n\tfor _, tc := range testCases {\n\t\tt.Run(tc.name, func(t *testing.T) {\n\t\t\terr := &mockHTTPError{statusCode: tc.statusCode}\n\t\t\tresult := TestIsRetryableError(err)\n\t\t\tassert.True(t, result, \"Expected %d to be retryable\", tc.statusCode)\n\t\t})\n\t}\n}\n\nfunc TestIsRetryableError_NetworkTimeout(t *testing.T) {\n\terr := &mockTimeoutError{message: \"connection timeout\"}\n\tresult := TestIsRetryableError(err)\n\tassert.True(t, result)\n}\n\nfunc TestIsRetryableError_NetworkTemporary(t *testing.T) {\n\terr := &mockTemporaryError{message: \"temporary network error\"}\n\tresult := TestIsRetryableError(err)\n\tassert.True(t, result)\n}\n\nfunc TestIsRetryableError_OpError(t *testing.T) {\n\terr := createMockOpError()\n\tresult := TestIsRetryableError(err)\n\tassert.True(t, result)\n}\n\nfunc TestIsRetryableError_DNSError(t *testing.T) {\n\terr := createMockDNSError()\n\tresult := TestIsRetryableError(err)\n\tassert.True(t, result)\n}\n\nfunc TestIsRetryableError_AccessDenied","signatures":{"ranges":[]},"detailedLines":[{"text":"func TestIsRetryableError_ServiceUnavailable(t *testing.T) {","lineNumber":608,"isSignature":false},{"text":"\terr := createRetryableError(\"ServiceUnavailable\", 503)","lineNumber":609,"isSignature":false},{"text":"\tresult := TestIsRetryableError(err)","lineNumber":610,"isSignature":false},{"text":"\tassert.True(t, result)","lineNumber":611,"isSignature":false},{"text":"}","lineNumber":612,"isSignature":false},{"text":"","lineNumber":613,"isSignature":false},{"text":"func TestIsRetryableError_InternalServerError(t *testing.T) {","lineNumber":614,"isSignature":false},{"text":"\terr := createRetryableError(\"InternalServerError\", 500)","lineNumber":615,"isSignature":false},{"text":"\tresult := TestIsRetryableError(err)","lineNumber":616,"isSignature":false},{"text":"\tassert.True(t, result)","lineNumber":617,"isSignature":false},{"text":"}","lineNumber":618,"isSignature":false},{"text":"","lineNumber":619,"isSignature":false},{"text":"func TestIsRetryableError_BadGateway(t *testing.T) {","lineNumber":620,"isSignature":false},{"text":"\terr := createRetryableError(\"BadGateway\", 502)","lineNumber":621,"isSignature":false},{"text":"\tresult := TestIsRetryableError(err)","lineNumber":622,"isSignature":false},{"text":"\tassert.True(t, result)","lineNumber":623,"isSignature":false},{"text":"}","lineNumber":624,"isSignature":false},{"text":"","lineNumber":625,"isSignature":false},{"text":"func TestIsRe