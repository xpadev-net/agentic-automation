{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cursor Agent Log Entry",
  "description": "Schema for cursor-agent log entries (one JSON object per line)",
  "oneOf": [
    {
      "$ref": "#/definitions/system"
    },
    {
      "$ref": "#/definitions/user"
    },
    {
      "$ref": "#/definitions/thinking"
    },
    {
      "$ref": "#/definitions/assistant"
    },
    {
      "$ref": "#/definitions/tool_call"
    },
    {
      "$ref": "#/definitions/result"
    }
  ],
  "definitions": {
    "system": {
      "type": "object",
      "required": ["type", "subtype", "session_id"],
      "properties": {
        "type": {
          "type": "string",
          "const": "system"
        },
        "subtype": {
          "type": "string",
          "enum": ["init"]
        },
        "apiKeySource": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "permissionMode": {
          "type": "string"
        }
      }
    },
    "user": {
      "type": "object",
      "required": ["type", "message", "session_id"],
      "properties": {
        "type": {
          "type": "string",
          "const": "user"
        },
        "message": {
          "type": "object",
          "required": ["role", "content"],
          "properties": {
            "role": {
              "type": "string",
              "const": "user"
            },
            "content": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["text"]
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "session_id": {
          "type": "string"
        }
      }
    },
    "thinking": {
      "type": "object",
      "required": ["type", "subtype", "session_id"],
      "properties": {
        "type": {
          "type": "string",
          "const": "thinking"
        },
        "subtype": {
          "type": "string",
          "enum": ["delta", "completed"]
        },
        "text": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "timestamp_ms": {
          "type": "integer"
        }
      }
    },
    "assistant": {
      "type": "object",
      "required": ["type", "message", "session_id"],
      "properties": {
        "type": {
          "type": "string",
          "const": "assistant"
        },
        "message": {
          "type": "object",
          "required": ["role", "content"],
          "properties": {
            "role": {
              "type": "string",
              "const": "assistant"
            },
            "content": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["text"]
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "session_id": {
          "type": "string"
        },
        "model_call_id": {
          "type": "string"
        },
        "timestamp_ms": {
          "type": "integer"
        }
      }
    },
    "tool_call": {
      "type": "object",
      "required": ["type", "subtype", "call_id", "tool_call", "session_id"],
      "properties": {
        "type": {
          "type": "string",
          "const": "tool_call"
        },
        "subtype": {
          "type": "string",
          "enum": ["started", "completed"]
        },
        "call_id": {
          "type": "string"
        },
        "tool_call": {
          "type": "object",
          "description": "Tool call object with a single key representing the tool name. The value structure may vary by tool type."
        },
        "model_call_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "timestamp_ms": {
          "type": "integer"
        }
      }
    },
    "result": {
      "type": "object",
      "required": ["type", "subtype", "session_id"],
      "properties": {
        "type": {
          "type": "string",
          "const": "result"
        },
        "subtype": {
          "type": "string",
          "enum": ["success", "error"]
        },
        "duration_ms": {
          "type": "integer"
        },
        "duration_api_ms": {
          "type": "integer"
        },
        "is_error": {
          "type": "boolean"
        },
        "result": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      }
    }
  }
}
